<style>

/* Parent grid handles width (280px) and placement. 
   Do not apply position: absolute/fixed here directly  */

.profile-sidebar {
  background: var(--bg-card, #ffffff);
  border-radius: var(--radius-lg, 16px);
  padding: 32px 24px;
  text-align: center;
  box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.05));
  border: 1px solid var(--border-color, #e2e8f0);
}

.avatar-container {
  position: relative;
  width: 120px;
  height: 120px;
  margin: 0 auto 16px;
  border-radius: 50%;
  padding: 4px; /* Space for the border ring */
  background: linear-gradient(135deg, var(--primary-blue, #1d4ed8), var(--tertiary-blue, #dbeafe));
}

.sidebar-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid var(--bg-card, #ffffff);
  background: #ffffff;
}

.profile-sidebar h3 {
  margin: 0 0 4px 0;
  color: var(--text-main, #0f172a);
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.01em;
}

.profile-sidebar .email {
  font-size: 14px;
  color: var(--text-muted, #475569);
  margin: 0 0 24px 0;
}

.sidebar-divider {
  height: 1px;
  background: var(--border-color, #e2e8f0);
  margin: 24px 0;
}

/* ================= Sidebar Navigation Menu ================= */
.profile-menu {
  list-style: none;
  padding: 0;
  margin: 0;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.profile-menu li {
  margin: 0;
}

.profile-menu a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-radius: var(--radius-sm, 8px);
  text-decoration: none;
  color: var(--text-muted, #475569);
  font-weight: 600;
  font-size: 15px;
  transition: var(--transition, all 0.25s ease);
  cursor: pointer;
}

.profile-menu a svg {
  color: var(--text-light, #94a3b8);
  transition: var(--transition, all 0.25s ease);
}

/* Hover & Active States */
.profile-menu a:hover,
.profile-menu a.active {
  background-color: var(--secondary-blue, #eff6ff);
  color: var(--primary-blue, #1d4ed8);
}

.profile-menu a:hover svg,
.profile-menu a.active svg {
  color: var(--primary-blue, #1d4ed8);
}

/* Logout Item specifically */
.profile-menu .logout-btn {
  color: var(--danger, #ef4444);
  margin-top: 16px;
}

.profile-menu .logout-btn svg {
  color: var(--danger, #ef4444);
}

.profile-menu .logout-btn:hover {
  background-color: var(--danger-bg, #fee2e2);
  color: var(--danger, #ef4444);
}

/* ================= LOGOUT MODAL ================= */
.logout-modal {
  display: none;
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4px);
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.logout-box {
  background: var(--bg-card, #ffffff);
  width: 90%;
  max-width: 400px;
  padding: 32px;
  border-radius: var(--radius-lg, 16px);
  text-align: center;
  box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
  animation: modalAppears 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes modalAppears {
  from { opacity: 0; transform: translateY(20px) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.modal-icon-wrap {
  width: 64px; height: 64px; border-radius: 50%; background: var(--danger-bg, #fee2e2); color: var(--danger, #ef4444); display: flex; justify-content: center; align-items: center; margin: 0 auto 20px;
}

.logout-box h3 { color: var(--text-main, #0f172a); margin: 0 0 12px; font-size: 24px; font-weight: 800; }
.logout-box p { color: var(--text-muted, #475569); font-size: 15px; margin: 0 0 32px; }

.logout-actions { display: flex; gap: 12px; }
.logout-actions form { flex: 1; margin: 0; }
.logout-actions .btn { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 24px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.25s ease; border: none; text-decoration: none; }
.logout-actions .btn-primary { background: var(--primary-blue, #1d4ed8); color: white; box-shadow: 0 4px 10px rgba(29, 78, 216, 0.2); }
.logout-actions .btn-primary:hover { background: #1e40af; transform: translateY(-2px); box-shadow: 0 6px 15px rgba(29, 78, 216, 0.3); }
.logout-actions .btn-outline { background: var(--bg-main, #f8fafc); color: var(--text-main, #0f172a); border: 1px solid var(--border-color, #e2e8f0); }
.logout-actions .btn-outline:hover { border-color: var(--primary-blue, #1d4ed8); color: var(--primary-blue, #1d4ed8); }
</style>

<aside class="profile-sidebar">
  <div class="avatar-container">
    <img
      src="<%= (user && user.profileImage) ? user.profileImage : '/images/default-avatar.png' %>"
      alt="Profile Image"
      class="sidebar-avatar"
    />
  </div>

  <h3><%= user.name %></h3>
  <p class="email"><%= user.email %></p>

  <div class="sidebar-divider"></div>

  <ul class="profile-menu">
    <li>
      <a href="/profile">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        My Profile
      </a>
    </li>
    <li>
      <a href="/orders">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
        Orders
      </a>
    </li>
    <li>
      <a href="/wallet">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
        Wallet
      </a>
    </li>
    
    <div class="sidebar-divider"></div>
    
    <li>
      <a href="/">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        Back to home
      </a>
    </li>
    <li>
      <a class="logout-btn" onclick="openLogoutModal()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Logout
      </a>
    </li>
  </ul>
</aside>

<!-- GLOBAL LOGOUT MODAL (For Sidebar) -->
<div id="logoutModal" class="logout-modal">
  <div class="logout-box">
    <div class="modal-icon-wrap">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
    </div>
    <h3>Confirm Logout</h3>
    <p>Are you sure you want to end your session?</p>
    <div class="logout-actions">
      <form action="/logout" method="POST">
        <button type="submit" class="btn btn-primary">Yes, Logout</button>
      </form>
      <button type="button" class="btn btn-outline" onclick="closeLogoutModal()">Cancel</button>
    </div>
  </div>
</div>

<script>
  function openLogoutModal() {
    document.getElementById("logoutModal").style.display = "flex";
  }
  function closeLogoutModal() {
    document.getElementById("logoutModal").style.display = "none";
  }
</script>
