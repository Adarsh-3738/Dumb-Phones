
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Inter", sans-serif;
  }

  .sidebar {
    width: 250px;
    background: #ffffff;
    height: 100vh;
    border-right: 1px solid #e6e6e6;
    padding: 20px;
    position: fixed;
    left: 0;
    top: 0;
    overflow-y: auto;
  }

  .logo {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 30px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .menu-title {
    margin-top: 20px;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #777;
    margin-bottom: 10px;
  }

  .menu-item {
    display: flex;
    align-items: center;
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 5px;
    cursor: pointer;
    color: #333;
    transition: 0.2s;
    text-decoration: none;
  }

  .menu-item:hover,
  .menu-item.active {
    background: #eef3ff;
    color: #2a55ff;
  }

  .menu-item i {
    margin-right: 10px;
  }

  .logout-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 12px;
    border-radius: 10px;
    text-align: left;
    width: 100%;
  }

  .logout-btn:hover {
    background: #ffe5e5;
    color: #ff4444;
  }

  /* logout modal */

  .logout-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 9999;
  }

  .logout-modal {
    background: white;
    padding: 25px;
    width: 320px;
    border-radius: 12px;
    text-align: center;
    animation: fadeIn 0.2s ease;
  }

  .modal-actions {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
  }

  .btn {
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    border: none;
  }

  .btn.cancel {
    background: #ddd;
  }

  .btn.logout {
    background: #ff4d4d;
    color: white;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }
</style>

<!-- SIDEBAR -->

<div class="sidebar">
  <div class="logo">📱 Dumb Phones</div>

  <div class="menu-title">Menu</div>

  <a href="/admin/dashboard" class="menu-item nav-link">📊 Dashboard</a>
  <a href="/admin/products" class="menu-item nav-link">📦 Products</a>
  <a href="/admin/orders" class="menu-item nav-link">🧾 Orders</a>
  <a href="/admin/users" class="menu-item nav-link">👥 Users</a>
  <a href="/admin/brands" class="menu-item nav-link">🏷 Brand</a>
  <a href="/admin/offers" class="menu-item nav-link">🎁 Offers</a>
  <a href="/admin/referrals" class="menu-item nav-link">🔗 Referrals</a>
  <a href="/admin/reviews" class="menu-item nav-link">⭐ Reviews</a>
  <a href="/admin/coupons" class="menu-item nav-link">🎫 Coupons</a>
  <a href="/admin/sales" class="menu-item nav-link">📈 Sales</a>
  <a href="/admin/category" class="menu-item nav-link">📂 Category</a>
  <a href="/admin/banners" class="menu-item nav-link">🖼 Banners</a>

  <div class="menu-title" style="margin-top: 40px;">Admin</div>

  <div class="menu-item">👤 Admin Name</div>

  <button class="menu-item logout-btn" onclick="openLogoutModal()">🚪 Logout</button>
</div>

<!-- LOGOUT MODAL  -->

<div id="logoutModal" class="logout-modal-overlay">
  <div class="logout-modal">
    <h3>Confirm Logout</h3>
    <p>Are you sure you want to logout?</p>

    <div class="modal-actions">
      <button class="btn cancel" onclick="closeLogoutModal()">Cancel</button>
      <a href="/admin/logout" class="btn logout">Logout</a>
    </div>
  </div>
</div>

<!-- JS SCRIPT -->

<script>
  // Highlight current active link
  const currentPath = window.location.pathname;
  const navLinks = document.querySelectorAll(".nav-link");

  navLinks.forEach(link => {
    if (currentPath.startsWith(link.getAttribute("href"))) {
      link.classList.add("active");
    }
  });

  // Logout modal controls
  function openLogoutModal() {
    document.getElementById("logoutModal").style.display = "flex";
  }

  function closeLogoutModal() {
    document.getElementById("logoutModal").style.display = "none";
  }

  // Close when clicking outside modal
  window.onclick = function(event) {
    const modal = document.getElementById("logoutModal");
    if (event.target === modal) {
      modal.style.display = "none";
    }
  }
</script>

