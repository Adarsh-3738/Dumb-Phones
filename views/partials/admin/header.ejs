<script src="https://unpkg.com/lucide@latest"></script>
<script src="https://unpkg.com/htmx.org@1.9.10"></script>
<script src="https://unpkg.com/htmx.org@1.9.10/dist/ext/preload.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Inter", sans-serif;
  }

  /* SIDEBAR */
  .sidebar {
    width: 250px;
    background: #ffffff;
    height: 100vh;
    border-right: 1px solid #e5eaf2;
    padding: 25px 20px;
    position: fixed;
    left: 0;
    top: 0;
    overflow-y: auto;
    z-index: 100;
  }

  /* LOGO */
  .logo {
    font-size: 20px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 12px;
    color: #1e3a8a;
    padding-bottom: 20px;
    border-bottom: 1px solid #eef2f7;
    margin-bottom: 25px; /* Proper spacing after logo */
  }

  .logo i {
    width: 22px;
    height: 22px;
    color: #2563eb;
  }

  /* MENU TITLE */
  .menu-title {
    margin-top: 20px;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 10px;
  }

  /* MENU ITEMS */
  .menu-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    margin-bottom: 6px;
    cursor: pointer;
    color: #334155;
    transition: all 0.2s ease;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }

  .menu-item i {
    width: 18px;
    height: 18px;
    stroke-width: 1.8;
  }

  /* HOVER + ACTIVE */
  .menu-item:hover {
    background: #eff6ff;
    color: #2563eb;
  }

  .menu-item.active {
    background: #2563eb;
    color: #ffffff;
  }

  .menu-item.active i {
    color: #ffffff;
  }

  /* LOGOUT BUTTON */
  .logout-btn {
    background: none;
    border: none;
    width: 100%;
    text-align: left;
  }

  .logout-btn:hover {
    background: #fee2e2;
    color: #dc2626;
  }

  .btn {
    flex: 1;
    padding: 10px;
    border-radius: 8px;
    cursor: pointer;
    border: none;
    font-weight: 500;
  }

  .btn.cancel {
    background: #e2e8f0;
  }

  .btn.logout {
    background: #2563eb;
    color: white;
  }

  .btn.logout:hover {
    background: #1e40af;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  /* Top progress bar for instant feedback */
  #admin-top-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: #2563eb;
    z-index: 9999;
    transition: width 0.2s ease, opacity 0.3s ease;
    opacity: 0;
  }

  /* Skeleton Loading Shimmer */
  .skeleton-shimmer {
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: 8px;
  }

  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

<div id="admin-top-bar"></div>

<!-- SIDEBAR -->
<div class="sidebar" hx-ext="preload">
  <div class="logo">
    <i data-lucide="smartphone"></i>
    Dumb Phones
  </div>

  <div class="menu-title">Menu</div>

  <a href="/admin/dashboard" hx-get="/admin/dashboard" hx-target="#admin-main-container" hx-select="#admin-main-container" hx-swap="outerHTML" hx-push-url="true" preload="hover" class="menu-item nav-link">
    <i data-lucide="layout-dashboard"></i> Dashboard
  </a>

  <a href="/admin/products" hx-get="/admin/products" hx-target="#admin-main-container" hx-select="#admin-main-container" hx-swap="outerHTML" hx-push-url="true" preload="hover" class="menu-item nav-link">
    <i data-lucide="package"></i> Products
  </a>

  <a href="/admin/orders" hx-get="/admin/orders" hx-target="#admin-main-container" hx-select="#admin-main-container" hx-swap="outerHTML" hx-push-url="true" preload="hover" class="menu-item nav-link">
    <i data-lucide="file-text"></i> Orders
  </a>

  <a href="/admin/users" hx-get="/admin/users" hx-target="#admin-main-container" hx-select="#admin-main-container" hx-swap="outerHTML" hx-push-url="true" preload="hover" class="menu-item nav-link">
    <i data-lucide="users"></i> Users
  </a>

  <a href="/admin/brands" hx-get="/admin/brands" hx-target="#admin-main-container" hx-select="#admin-main-container" hx-swap="outerHTML" hx-push-url="true" preload="hover" class="menu-item nav-link">
    <i data-lucide="tag"></i> Brand
  </a>

  <a href="/admin/offers" hx-get="/admin/offers" hx-target="#admin-main-container" hx-select="#admin-main-container" hx-swap="outerHTML" hx-push-url="true" preload="hover" class="menu-item nav-link">
    <i data-lucide="gift"></i> Offers
  </a>

  <a href="/admin/referrals" hx-get="/admin/referrals" hx-target="#admin-main-container" hx-select="#admin-main-container" hx-swap="outerHTML" hx-push-url="true" preload="hover" class="menu-item nav-link">
    <i data-lucide="link"></i> Referrals
  </a>

  <a href="/admin/coupons" hx-get="/admin/coupons" hx-target="#admin-main-container" hx-select="#admin-main-container" hx-swap="outerHTML" hx-push-url="true" preload="hover" class="menu-item nav-link">
    <i data-lucide="ticket"></i> Coupons
  </a>

  <a href="/admin/sales-report" hx-get="/admin/sales-report" hx-target="#admin-main-container" hx-select="#admin-main-container" hx-swap="outerHTML" hx-push-url="true" preload="hover" class="menu-item nav-link">
    <i data-lucide="trending-up"></i> Sales
  </a>

  <a href="/admin/category" hx-get="/admin/category" hx-target="#admin-main-container" hx-select="#admin-main-container" hx-swap="outerHTML" hx-push-url="true" preload="hover" class="menu-item nav-link">
    <i data-lucide="folder"></i> Category
  </a>


  <div class="menu-title" style="margin-top: 40px;">Admin</div>

  <div class="menu-item">
    <i data-lucide="user"></i> Admin
  </div>

  <button class="menu-item logout-btn" onclick="openLogoutModal()">
    <i data-lucide="log-out"></i> Logout
  </button>
</div>

<script src="/js/admin/header.js"></script>

<!-- Main content wrapper for HTMX content swapping -->
<div id="admin-main-container">
