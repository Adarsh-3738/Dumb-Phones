<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Inter", sans-serif;
    }

    body {
      background: #f5f7fb;
      display: flex;
    }

    /* Sidebar */
    .sidebar {
      width: 250px;
      background: #ffffff;
      height: 100vh;
      border-right: 1px solid #e6e6e6;
      padding: 20px;
      position: fixed;
    }

    .logo {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 30px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .menu-title {
      margin-top: 20px;
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #777;
      margin-bottom: 10px;
    }

    .menu-item {
      display: flex;
      align-items: center;
      padding: 12px;
      border-radius: 10px;
      margin-bottom: 5px;
      cursor: pointer;
      color: #333;
      transition: 0.2s;
    }

    .menu-item:hover,
    .active {
      background: #eef3ff;
      color: #2a55ff;
    }

    .menu-item i {
      margin-right: 10px;
    }

    /* Main content */
    .main {
      margin-left: 250px;
      width: calc(100% - 250px);
      padding: 20px 30px;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }

    .search-box input {
      width: 300px;
      padding: 10px 15px;
      border-radius: 8px;
      border: 1px solid #ddd;
      background: #fff;
    }

    .btn-export {
      background: #2a55ff;
      color: #fff;
      padding: 10px 18px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-weight: 600;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }

    .card {
      background: #fff;
      padding: 20px;
      border-radius: 12px;
      border: 1px solid #e8e8e8;
    }

    .card h4 {
      font-size: 14px;
      color: #666;
      margin-bottom: 10px;
    }

    .card h2 {
      font-size: 26px;
      margin-bottom: 5px;
    }

    .card small {
      color: #28a745;
      font-weight: 600;
    }

    /* Chart Box */
    .chart-box {
      background: #fff;
      padding: 25px;
      border-radius: 12px;
      border: 1px solid #e8e8e8;
    }

    .chart-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .chart-tabs button {
      border: none;
      padding: 8px 15px;
      border-radius: 6px;
      margin-left: 10px;
      cursor: pointer;
      background: #f2f2f2;
    }

    .chart-tabs .active {
      background: #2a55ff;
      color: #fff;
    }

    canvas {
      width: 100%;
      height: 260px;
    }

  </style>
</head>
<body>

  <!-- Sidebar -->
  <div class="sidebar">
    <div class="logo">📱 Dumb Phones</div>

    <div class="menu-title">Menu</div>

    <div class="menu-item active">📊 Dashboard</div>
    <div class="menu-item">📦 Products</div>
    <div class="menu-item">🧾 Orders</div>
    <a href="/admin/users"  class="menu-item">👥 Users></a>
    <div class="menu-item">🏷 Brand</div>
    <div class="menu-item">🎁 Offers</div>
    <div class="menu-item">🔗 Referrals</div>
    <div class="menu-item">⭐ Reviews</div>
    <div class="menu-item">🎫 Coupons</div>
    <div class="menu-item">📈 Sales</div>
    <div class="menu-item">📂 Category</div>
    <div class="menu-item">🖼 Banners</div>

    <div class="menu-title" style="margin-top: 40px;">Admin</div>
    <div class="menu-item">👤 Admin Name</div>
   <div class="menu-item" onclick="openLogoutModal()">🚪 Logout</div>

    
  </div>




<!-- Logout Confirmation Modal -->
<div id="logoutModal" 
     style="
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0,0,0,0.4);
        display: none;
        justify-content: center;
        align-items: center;
     ">
  <div style="
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        text-align: center;
        width: 320px;
      ">
    <h3>Are you sure?</h3>
    <p style="margin: 10px 0 20px;">Do you want to logout?</p>

    <button onclick="cancelLogout()" 
            style="
              padding: 8px 18px;
              margin-right: 10px;
              border-radius: 6px;
              border: none;
              cursor: pointer;
            ">
      Cancel
    </button>

    <button onclick="confirmLogout()" 
            style="
              padding: 8px 18px;
              background: #ff4444;
              color: white;
              border: none;
              border-radius: 6px;
              cursor: pointer;
            ">
      Logout
    </button>
  </div>
</div>



<script>
  function openLogoutModal() {
    document.getElementById("logoutModal").style.display = "flex";
  }

  function cancelLogout() {
    document.getElementById("logoutModal").style.display = "none";
  }

  function confirmLogout() {
    window.location.href = "/admin/logout"; 
  }
</script>

