<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Addresses</title>
  <link rel="stylesheet" href="/css/user/address.css">
</head>
<body>

<%- include("../../views/partials/user/header") %>
<div class="profile-wrapper">
<%- include("../../views/partials/user/sidebar.ejs") %>
<div class="address-container">
  <div class="address-header">
    <h2>My Addresses</h2>
    <a href="/add-address" class="add-btn">+ Add Address</a>
  </div>

  <% if (!addresses || addresses.length === 0) { %>

    <p class="empty">No addresses added yet.</p>
  <% } %>

        <div class="address-list">
  <% addresses.forEach(addr => { %>
    <div class="address-card">
      <p>
        <strong><%= addr.name %></strong> (<%= addr.addressType %>)<br>
        <%= addr.landmark %>, <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %><br>
        Phone: <%= addr.phone %> <% if (addr.altPhone) { %> / <%= addr.altPhone %> <% } %>
      </p>


        <div class="address-actions">
          <a href="/address/edit/<%= addr._id %>" class="edit-btn">Edit</a>

          <form action="/address/delete/<%= addr._id %>" method="POST">

            <button 
  type="button" 
  class="delete-btn"
  onclick="openDeleteModal('<%= addr._id %>')">
  Delete
</button>

          </form>
        </div>
      </div>
    <% }) %>
  </div>

  <a href="/profile" class="back-btn">← Back to Profile</a>
</div>
<!-- modal for delete address -->

<!-- DELETE CONFIRM MODAL -->
<div id="deleteModal" class="modal-overlay">
  <div class="modal-box">
    <h3>Delete Address</h3>
    <p>Are you sure you want to delete this address?</p>

    <div class="modal-actions">
      <button class="cancel-btn" onclick="closeDeleteModal()">Cancel</button>

      <form id="deleteForm" method="POST">
        <button type="submit" class="confirm-btn">Yes, Delete</button>
      </form>
    </div>
  </div>
</div>

</div>


<%- include("../../views/partials/user/footer") %>

</body>


<script>
  const modal = document.getElementById("deleteModal");
  const deleteForm = document.getElementById("deleteForm");

  function openDeleteModal(addressId) {
    deleteForm.action = `/address/delete/${addressId}`;
    modal.style.display = "flex";
  }

  function closeDeleteModal() {
    modal.style.display = "none";
  }
</script>

</html>
