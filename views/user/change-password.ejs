<link rel="stylesheet" href="/css/user/change-password.css">

<%- include("../partials/user/header") %>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<div class="profile-wrapper">

  <!-- Sidebar -->
  <%- include("../../views/partials/user/sidebar.ejs") %>

 
  <main class="profile-content">
    <nav class="breadcrumb">
      <a href="/profile">Profile</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      <span class="active">Security</span>
    </nav>
    <div class="change-password-container">
      <h2>Change Password</h2>

      

      <form id="changePasswordForm" action="/change-password" method="POST">

        <div class="form-group">
          <label>Current Password</label>
          <div class="password-field">
            <input type="password" id="currentPassword" name="currentPassword">
            <span class="toggle-password">👁</span>
          </div>
          <div class="error-message" id="error-currentPassword"></div>
        </div>

        <div class="form-group">
          <label>New Password</label>
          <div class="password-field">
            <input type="password" id="newPassword" name="newPassword">
            <span class="toggle-password">👁</span>
          </div>
          <div class="error-message" id="error-newPassword"></div>
        </div>

        <div class="form-group">
          <label>Confirm New Password</label>
          <div class="password-field">
            <input type="password" id="confirmPassword" name="confirmPassword">
            <span class="toggle-password">👁</span>
          </div>
          <div class="error-message" id="error-confirmPassword"></div>
        </div>

        <button type="submit">Change Password</button>

        <a href="/profile" class="back-btn">← Back to Profile</a>
      </form>
    </div>
  </main>

</div>

<%- include("../partials/user/footer") %>

<script src="/js/user/change-password.js"></script>