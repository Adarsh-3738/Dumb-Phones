<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Page Not Found' %> | DumbPhones</title>
  <link rel="stylesheet" href="/css/user/page-404.css">
  <style>
    .error-wrapper {
      min-height: 60vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 20px;
      text-align: center;
      background: #f8fafc;
    }
    .error-box {
      max-width: 500px;
      background: white;
      padding: 40px 30px;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.04);
      border: 1px solid #e2e8f0;
    }
    .error-badge {
      font-size: 80px;
      font-weight: 800;
      color: #2563eb;
      line-height: 1;
      margin-bottom: 10px;
    }
    .error-heading {
      font-size: 24px;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 12px;
    }
    .error-desc {
      font-size: 14px;
      color: #64748b;
      margin-bottom: 30px;
      line-height: 1.6;
    }
    .btn-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
    }
    .btn-home {
      background: #2563eb;
      color: white;
      text-decoration: none;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      transition: 0.2s;
    }
    .btn-home:hover { background: #1d4ed8; }
    .btn-shop {
      background: #f1f5f9;
      color: #0f172a;
      text-decoration: none;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      border: 1px solid #cbd5e1;
      transition: 0.2s;
    }
    .btn-shop:hover { background: #e2e8f0; }
  </style>
</head>
<body>

<%- include("../partials/user/header") %>

<div class="error-wrapper">
  <div class="error-box">
    <div class="error-badge"><%= typeof statusCode !== 'undefined' ? statusCode : '404' %></div>
    <h2 class="error-heading"><%= typeof title !== 'undefined' ? title : 'Page Not Found' %></h2>
    <p class="error-desc">
      <%= typeof message !== 'undefined' ? message : "Oops! The page you are looking for might have been removed, renamed, or is temporarily unavailable." %>
    </p>
    <div class="btn-actions">
      <a href="/" class="btn-home">Go to Homepage</a>
      <a href="/shop" class="btn-shop">Browse Shop</a>
    </div>
  </div>
</div>

<%- include("../partials/user/footer") %>

</body>
</html>
