<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f9;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      text-align: center;
    }

    .container {
      max-width: 400px;
    }

    h1 {
      font-size: 80px;
      margin: 0;
      color: #ff4757;
    }

    p {
      font-size: 18px;
      margin-top: 10px;
      color: #555;
    }

    a {
      margin-top: 20px;
      display: inline-block;
      padding: 10px 20px;
      background: #2d77ff;
      color: #fff;
      border-radius: 6px;
      text-decoration: none;
      font-weight: bold;
    }

    a:hover {
      background: #1b5ae0;
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>404</h1>
    <p>Oops! The page you're looking for doesn't exist.</p>
    <a href="/">Go Home</a>
  </div>

</body>
</html>
