<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop | Premium Collection</title>
  <link rel="stylesheet" href="/css/user/shop.css">
</head>
<body>

<%- include("../../views/partials/user/header") %>

<main class="shop-container">

  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/">Home</a>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <span class="active">Shop Collection</span>
  </nav>

  <div class="shop-header-title">
    <h2>Explore Our Collection</h2>
    <p class="subtitle"><%= products.length %> Premium Products Tailored For You</p>
  </div>

  <div class="shop-layout">

    <!-- FILTER SIDEBAR -->
    <aside class="filter-sidebar">
      <div class="filter-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
        <h3>Filters & Refining</h3>
      </div>

      <form method="GET" action="/shop" class="filter-form">

        <div class="filter-group">
          <label>Category</label>
          <div class="custom-select-wrapper">
            <select name="category">
              <option value="">All Categories</option>
              <% categories.forEach(c => { %>
                <option value="<%= c._id %>" <%= category == c._id.toString() ? 'selected' : '' %>>
                  <%= c.name %>
                </option>
              <% }) %>
            </select>
            <svg class="select-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>
        </div>

        <div class="filter-group">
          <label>Brand</label>
          <div class="custom-select-wrapper">
            <select name="brand">
              <option value="">All Brands</option>
              <% brands.forEach(b => { %>
                <option value="<%= b._id %>" <%= brand == b._id.toString() ? 'selected' : '' %>>
                  <%= b.name %>
                </option>
              <% }) %>
            </select>
            <svg class="select-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>
        </div>

        <div class="filter-group">
          <label>Price Range</label>
          <div class="custom-select-wrapper">
            <select name="price">
              <option value="">All Prices</option>
              <option value="0-1000" <%= price === '0-1000' ? 'selected' : '' %>>Below ₹1,000</option>
              <option value="1000-5000" <%= price === '1000-5000' ? 'selected' : '' %>>₹1,000 - ₹5,000</option>
              <option value="5000-10000" <%= price === '5000-10000' ? 'selected' : '' %>>₹5,000 - ₹10,000</option>
              <option value="10000-999999" <%= price === '10000-999999' ? 'selected' : '' %>>Above ₹10,000</option>
            </select>
            <svg class="select-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>
        </div>

        <div class="filter-group">
          <label>Sort By</label>
          <div class="custom-select-wrapper">
            <select name="sort">
              <option value="">New Arrivals</option>
              <option value="priceLowHigh" <%= sort === 'priceLowHigh' ? 'selected' : '' %>>Price: Low to High</option>
              <option value="priceHighLow" <%= sort === 'priceHighLow' ? 'selected' : '' %>>Price: High to Low</option>
              <option value="aToZ" <%= sort === 'aToZ' ? 'selected' : '' %>>A - Z</option>
              <option value="zToA" <%= sort === 'zToA' ? 'selected' : '' %>>Z - A</option>
            </select>
            <svg class="select-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>
        </div>

        <input type="hidden" name="search" value="<%= search || '' %>">

        <div class="filter-actions">
          <button type="submit" class="apply-btn">
            Apply Filters
          </button>
          <a href="/shop" class="clear-btn">
            Clear All
          </a>
        </div>

      </form>
    </aside>

    <!-- PRODUCTS  -->
    <section class="product-section">
      <% if (products.length === 0) { %>
        <div class="empty-state">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <h3>No products found</h3>
          <p>We couldn't find anything matching your filter criteria. Try adjusting your filters.</p>
          <a href="/shop" class="clear-btn mt-4">Clear Filters</a>
        </div>
      <% } else { %>
        <div class="product-grid">
          <% products.forEach(product => { %>
            <a href="/product/<%= product._id %>" class="product-card">
              
              <div class="card-img-wrap">
                <!-- Wishlist Button -->
                <% const isWishlisted = typeof wishlistedProducts !== 'undefined' && wishlistedProducts.includes(product._id.toString()); %>
                <button type="button" class="wishlist-btn-shop" onclick="toggleWishlist('<%= product._id %>', event)" aria-label="Add to Wishlist" style="position: absolute; top: 10px; right: 10px; background: white; border: none; border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 10; box-shadow: 0 2px 5px rgba(0,0,0,0.1); transition: transform 0.2s;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="<%= isWishlisted ? '#ef4444' : 'none' %>" stroke="<%= isWishlisted ? '#ef4444' : '#64748b' %>" stroke-width="2" class="heart-icon"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>

                <% if (product.defaultVariant && product.defaultVariant.quantity <= 0) { %>
                  <span class="stock-badge absolute-badge">Out of Stock</span>
                <% } %>

                <% if (product.defaultVariant && product.defaultVariant.quantity > 0 && product.defaultVariant.salesPrice < product.defaultVariant.regularPrice) { 
                     const discountPct = Math.round(((product.defaultVariant.regularPrice - product.defaultVariant.salesPrice) / product.defaultVariant.regularPrice) * 100);
                %>
                  <span class="sale-badge absolute-badge" style="top: 10px; left: 10px; background: #ef4444; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; position: absolute; z-index: 10;">-<%= discountPct %>% OFF</span>
                <% } %>

                <% if (product.defaultVariant?.variantImages?.length) { %>
                  <img src="<%= product.defaultVariant.variantImages[0].url %>" alt="<%= product.productName %>" loading="lazy">
                <% } else { %>
                  <img src="/images/no-image.png" loading="lazy">
                <% } %>
              </div>

              <div class="card-info">
                <p class="brand"><%= product.brand?.name || "Brand" %></p>
                <h4 class="product-title" style="margin-bottom: 6px;"><%= product.productName %></h4>
                
                <% if (product.description) { %>
                  <p class="product-desc" style="font-size: 13px; color: #64748b; margin-bottom: 12px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; line-height: 1.4;">
                    <%= product.description %>
                  </p>
                <% } %>

                <% if (product.attributes && product.attributes.colors && product.attributes.colors.length > 0) { %>
                  <div class="product-colors" style="display: flex; gap: 6px; margin-bottom: 10px; align-items: center;">
                    <% product.attributes.colors.slice(0, 4).forEach(color => { 
                         // Basic mapping for colors to standard CSS if needed
                         let cssColor = color.toLowerCase();
                         if (cssColor === 'navy') cssColor = '#000080';
                    %>
                      <span style="width: 14px; height: 14px; border-radius: 50%; background-color: <%= cssColor %>; border: 1px solid #cbd5e1; display: inline-block;" title="<%= color %>"></span>
                    <% }) %>
                    <% if (product.attributes.colors.length > 4) { %>
                      <span style="font-size: 11px; color: #64748b; line-height: 14px; font-weight: 600;">+<%= product.attributes.colors.length - 4 %></span>
                    <% } %>
                  </div>
                <% } %>
                
                <% if (product.defaultVariant) { %>
                  <div class="price-wrap">
                    <span class="sale-price">₹<%= parseInt(product.defaultVariant.salesPrice).toLocaleString('en-IN') %></span>
                    <% if (product.defaultVariant.regularPrice > product.defaultVariant.salesPrice) { %>
                      <span class="regular-price">₹<%= parseInt(product.defaultVariant.regularPrice).toLocaleString('en-IN') %></span>
                    <% } %>
                  </div>
                <% } else { %>
                  <p class="price-unavailable">Price unavailable</p>
                <% } %>
              </div>

            </a>
          <% }) %>
        </div>
      <% } %>

      <!--  PAGINATION  -->
      <% if (totalPages > 1) { %>
        <div class="pagination-wrapper">
          <div class="pagination">
            <% if (currentPage > 1) { %>
              <a href="?page=<%= currentPage - 1 %>&category=<%= category || '' %>&brand=<%= brand || '' %>&price=<%= price || '' %>&sort=<%= sort || '' %>&search=<%= search || '' %>" class="page-arrow" aria-label="Previous">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
              </a>
            <% } else { %>
              <span class="page-arrow disabled">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
              </span>
            <% } %>

            <div class="page-numbers">
              <% for (let i = 1; i <= totalPages; i++) { %>
                <% if (i === currentPage) { %>
                  <span class="page-num active"><%= i %></span>
                <% } else { %>
                  <a href="?page=<%= i %>&category=<%= category || '' %>&brand=<%= brand || '' %>&price=<%= price || '' %>&sort=<%= sort || '' %>&search=<%= search || '' %>" class="page-num"><%= i %></a>
                <% } %>
              <% } %>
            </div>

            <% if (currentPage < totalPages) { %>
              <a href="?page=<%= currentPage + 1 %>&category=<%= category || '' %>&brand=<%= brand || '' %>&price=<%= price || '' %>&sort=<%= sort || '' %>&search=<%= search || '' %>" class="page-arrow" aria-label="Next">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
              </a>
            <% } else { %>
              <span class="page-arrow disabled">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
              </span>
            <% } %>
          </div>
        </div>
      <% } %>
    </section>

  </div>
</main>

<%- include("../../views/partials/user/footer") %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/user/shop.js"></script>

</body>
</html>