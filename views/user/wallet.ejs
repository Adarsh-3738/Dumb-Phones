<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Wallet | DumbPhones</title>
  <link rel="stylesheet" href="/css/user/wallet.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
  <%- include("../partials/user/header") %>
  
  <div class="profile-wrapper">
    <%- include("../../views/partials/user/sidebar.ejs") %>

    <main class="profile-content">
      
      <!-- BREADCRUMB -->
      <nav class="breadcrumb">
        <a href="/profile">Profile</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        <span class="active">My Wallet</span>
      </nav>

      <div class="orders-header">
        <h2>My Wallet</h2>
        <p class="subtitle">Manage your funds and view transaction history</p>
      </div>

      <div class="wallet-card">
        <div class="balance-info">
          <h3>Available Balance</h3>
          <div class="balance">₹ <%= wallet.balance.toFixed(2) %></div>
        </div>
        <div class="wallet-actions">
          <button id="addMoneyBtn" class="btn-add">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Money
          </button>
        </div>
      </div>

      <div class="transactions-section">
        <div class="section-header">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          <h3>Transaction History</h3>
        </div>

        <% if (wallet.transactions.length > 0) { %>
          <div class="table-container">
            <table class="transactions-table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Description</th>
                  <th>Type</th>
                  <th class="text-right">Amount</th>
                </tr>
              </thead>
              <tbody>
                <% [...wallet.transactions].reverse().forEach(txn => { %>
                  <tr>
                    <td><%= new Date(txn.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                    <td><%= txn.description %></td>
                    <td>
                      <span class="type-badge <%= txn.type %>"><%= txn.type === 'credit' ? 'Credit' : 'Debit' %></span>
                    </td>
                    <td class="text-right amount <%= txn.type %>">
                      <%= txn.type === 'credit' ? '+' : '-' %> ₹<%= parseInt(txn.amount).toLocaleString('en-IN') %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
            <p>No transactions yet</p>
            <span>Your wallet activity will appear here</span>
          </div>
        <% } %>
      </div>

    </main>
  </div>

  <%- include("../partials/user/footer") %>

  <script src="/js/user/wallet.js"></script>
</body>
</html>
