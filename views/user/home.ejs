<!-- header -->
 <%-include("../../views/partials/user/header")%>


 <link rel="stylesheet" href="/css/user/home.css">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-left">
      <h1>DISCOVER THE BEST <br> PHONES FOR YOU</h1>
      <p></p>
       <a href="/shop" class="btn-primary">Shop Now</a>

    </div>

    <div class="hero-right">
      <img src="/images/hero-phone.png" alt="">
    </div>
  </section>


 <section class="featured">
  <h2>Featured Phones</h2>

  <div class="products-grid">
    <% if (products.length > 0) { %>
      <% products.forEach(product => { %>

        
        <a href="/product/<%= product._id %>" class="product-link">
          <div class="product-card">
            <% if (product.productImage && product.productImage.length > 0) { %>
              <img src="<%= product.productImage[0].url %>" alt="<%= product.productName %>">
            <% } else { %>
              <img src="/images/placeholder.png" alt="No image">
            <% } %>
            <div class="info">
              <h4><%= product.brand?.name %></h4>
              <h3><%= product.productName %></h3>
              <p>₹<%= product.salesPrice %> 
                 <span style="text-decoration:line-through;color:#999;">
                   ₹<%= product.regularPrice %>
                 </span>
              </p>
            </div>
            <button class="cart-btn">Add to Cart</button>
          </div>
        </a>

      <% }) %>
    <% } else { %>
      <p>No products available</p>
    <% } %>
  </div>
</section>


  <!-- PAGINATION -->
  <div class="pagination">

  <% if (currentPage > 1) { %>
    <a href="?page=<%= currentPage - 1 %>&search=<%= search || '' %>&sort=<%= sort || '' %>&brand=<%= brand || '' %>&category=<%= category || '' %>&price=<%= price || '' %>">
      Previous
    </a>
  <% } else { %>
    <a class="disabled">Previous</a>
  <% } %>

  <% for (let i = 1; i <= totalPages; i++) { %>
    <a
      class="<%= i === currentPage ? 'active' : '' %>"
      href="?page=<%= i %>&search=<%= search || '' %>&sort=<%= sort || '' %>&brand=<%= brand || '' %>&category=<%= category || '' %>&price=<%= price || '' %>">
      <%= i %>
    </a>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <a href="?page=<%= currentPage + 1 %>&search=<%= search || '' %>&sort=<%= sort || '' %>&brand=<%= brand || '' %>&category=<%= category || '' %>&price=<%= price || '' %>">
      Next
    </a>
  <% } else { %>
    <a class="disabled">Next</a>
  <% } %>

</div>

<!-- footer -->
 <%-include("../../views/partials/user/footer")%>
  

</body>
</html>
