
<!-- header -->
 <%-include("../../views/partials/user/header")%>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-left">
      <h1>DISCOVER THE BEST <br> PHONES FOR YOU</h1>
      <p>Premium mobiles with cutting-edge technology</p>
      <button class="btn-primary">Shop Now</button>
    </div>

    <div class="hero-right">
      <img src="/images/hero-phone.png" alt="">
    </div>
  </section>

  <!-- FILTER TABS -->
  <section class="filters">
    <button class="active">All Phones</button>
    <button>Foldable</button>
    <button>Keypad</button>
    <button>Touch</button>
    <button>Keypad & Touch</button>
    <button>Offers</button>
  </section>

  <!-- SORT + FILTER -->
  <section class="sort-filter">
    <div>
      Sort by:
      <select>
        <option>Featured</option>
      </select>
    </div>

    <div>
      Filter by:
      <select>
        <option>Brands</option>
      </select>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="featured">
    <h2>Featured Phones</h2>

   

    </div>
  </section>

  <!-- PAGINATION -->
  <div class="pagination">
    <a class="disabled">Previous</a>
    <a class="active">1</a>
    <a>2</a>
    <a>3</a>
    <a>4</a>
    <a>5</a>
    <a>Next</a>
  </div>
<!-- footer -->
 <%-include("../../views/partials/user/footer")%>
  
<!-- CSS -->
  <style>

    *{
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Poppins", sans-serif;
    }

    body {
      background: #f5f7fa;
      color: #1a1a1a;
    }

    /* NAVBAR */
    .navbar {
      width: 100%;
      height: 70px;
      background: #fff;
      padding: 0 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0px 2px 6px rgba(0,0,0,0.08);
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 20px;
      font-weight: 600;
    }

    .logo img {
      width: 28px;
      height: 28px;
    }

    .search-box input {
      width: 320px;
      padding: 10px 12px;
      border: 1px solid #e2e2e2;
      border-radius: 8px;
      outline: none;
      font-size: 14px;
      background: #fafafa;
    }

    .nav-icons a {
      margin-left: 20px;
      font-size: 20px;
      color: #333;
      text-decoration: none;
    }

    /* HERO */
    .hero {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #0d5cf5;
      padding: 70px 60px;
      color: #fff;
    }

    .hero-left h1 {
      font-size: 46px;
      font-weight: 700;
      line-height: 1.3;
    }

    .hero-left p {
      margin-top: 10px;
      opacity: 0.9;
    }

    .btn-primary {
      margin-top: 20px;
      padding: 12px 26px;
      background: #fff;
      color: #0d5cf5;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 16px;
      font-weight: 600;
    }

    .hero-right img {
      width: 350px;
      border-radius: 12px;
    }

    /* FILTER TABS */
    .filters {
      display: flex;
      gap: 10px;
      padding: 20px 40px;
      margin-top: 10px;
    }

    .filters button {
      padding: 8px 18px;
      border: 1px solid #e1e1e1;
      background: #fff;
      border-radius: 20px;
      cursor: pointer;
      font-size: 14px;
    }

    .filters .active {
      background: #0d5cf5;
      color: #fff;
      border: none;
    }

    /* SORT / FILTER */
    .sort-filter {
      padding: 10px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    select {
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid #ccc;
    }

    /* PRODUCT GRID */
    .featured {
      padding: 20px 40px;
    }

    .featured h2 {
      margin-bottom: 20px;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .product-card {
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 6px rgba(0,0,0,0.08);
      padding-bottom: 20px;
      transition: 0.2s;
    }

    .product-card:hover {
      transform: translateY(-4px);
    }

    .product-card img {
      width: 100%;
      border-bottom: 1px solid #eee;
    }

    .product-card .info {
      padding: 15px;
    }

    .product-card h4 {
      font-size: 14px;
      color: #555;
    }

    .product-card h3 {
      font-size: 18px;
      margin: 6px 0;
    }

    .product-card p {
      color: #777;
      font-size: 14px;
      margin-top: 4px;
    }

    .product-card h2 {
      margin-top: 10px;
      font-size: 20px;
      font-weight: 700;
    }

    .cart-btn {
      margin: 15px;
      width: calc(100% - 30px);
      padding: 10px;
      background: #0d5cf5;
      border: none;
      color: #fff;
      font-size: 15px;
      border-radius: 8px;
      cursor: pointer;
    }

    /* PAGINATION */
    .pagination {
      padding: 30px;
      display: flex;
      justify-content: center;
      gap: 12px;
    }

    .pagination a {
      padding: 8px 14px;
      border-radius: 6px;
      background: #fff;
      border: 1px solid #ddd;
      cursor: pointer;
      font-size: 14px;
    }

    .pagination .active {
      background: #0d5cf5;
      color: #fff;
    }

    .pagination .disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* FOOTER */
    footer {
      padding: 40px;
      background: #fff;
      margin-top: 40px;
      border-top: 1px solid #eee;
    }

    .footer-columns {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    footer h4 {
      margin-bottom: 10px;
      font-size: 16px;
    }

    footer p {
      margin-top: 6px;
      color: #777;
      font-size: 14px;
      cursor: pointer;
    }

    footer p:hover {
      text-decoration: underline;
    }

    .copyright {
      text-align: center;
      color: #999;
      margin-top: 10px;
    }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      .products-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .hero {
        flex-direction: column;
        text-align: center;
      }
    }

    @media (max-width: 600px) {
      .products-grid {
        grid-template-columns: 1fr;
      }

      .navbar {
        flex-direction: column;
        height: auto;
        padding: 20px;
      }

      .search-box input {
        width: 100%;
        margin-top: 10px;
      }
    }

  </style>
</body>
</html>
