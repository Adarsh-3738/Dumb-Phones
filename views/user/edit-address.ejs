<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Address</title>
  <link rel="stylesheet" href="/css/user/add-address.css">
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
</head>

<body>

<%- include("../partials/user/header") %>
<div class="profile-wrapper">
  <%- include("../../views/partials/user/sidebar.ejs") %>
  <main class="profile-content">
    <nav class="breadcrumb">
      <a href="/profile">Profile</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      <a href="/address">My Addresses</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      <span class="active">Edit Address</span>
    </nav>
    <div class="add-address-container">
      <h2>Edit Address</h2>

<% if (message) { %> <p class="error"><%= message %></p>
<% } %>

  <form action="/address/edit/<%= address._id %>?_method=PATCH" method="POST" class="address-form">


<div class="form-group">
  <label>Address Type</label>
  <input type="text" name="addressType" id="addressType" value="<%= address.addressType %>">
  <div class="error-message" id="error-addressType"></div>
</div>

<div class="form-group">
  <label>Full Name</label>
  <input type="text" name="name" id="name" value="<%= address.name %>">
  <div class="error-message" id="error-name"></div>
</div>

<div class="form-group">
  <label>Phone</label>
  <input type="text" name="phone" id="phone" value="<%= address.phone %>">
  <div class="error-message" id="error-phone"></div>
</div>

<div class="form-group">
  <label>Alternate Phone</label>
  <input type="text" name="altPhone" id="altPhone" value="<%= address.altPhone %>">
  <div class="error-message" id="error-altPhone"></div>
</div>

<div class="form-group">
  <label>Landmark</label>
  <input type="text" name="landmark" id="landmark" value="<%= address.landmark %>">
  <div class="error-message" id="error-landmark"></div>
</div>

<div class="form-group">
  <label>City</label>
  <input type="text" name="city" id="city" value="<%= address.city %>">
  <div class="error-message" id="error-city"></div>
</div>

<div class="form-group">
  <label>State</label>
  <input type="text" name="state" id="state" value="<%= address.state %>">
  <div class="error-message" id="error-state"></div>
</div>

<div class="form-group">
  <label>Pincode</label>
  <input type="text" name="pincode" id="pincode" value="<%= address.pincode %>">
  <div class="error-message" id="error-pincode"></div>
</div>

<div class="form-actions">
  <button type="submit" class="btn-submit">Update Address</button>
  <a href="/address" class="btn-cancel">Cancel</a>
</div>


  </form>
</div>
</main>
</div>

<%- include("../partials/user/footer") %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/js/user/edit-address.js"></script>
</body>
</html>
