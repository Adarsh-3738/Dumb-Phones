<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Create Account</title>

  <!-- CSS -->
  <link rel="stylesheet" href="/css/user/signup.css" />
</head>

<body>
  <div class="container">
    <h2>Create Account</h2>
    <p>Sign up to get started with our service</p>

    <form id="signform" action="/signup" method="POST">

      <div class="input-box">
        <input type="text" id="name" name="name" placeholder="Full Name" />
        <div id="error1" class="error-message"></div>
      </div>

      <div class="input-box">
        <input type="tel" id="phone" name="phone" placeholder="Phone Number" />
        <div id="error2" class="error-message"></div>
      </div>

      <div class="input-box">
        <input type="email" id="email" name="email" placeholder="Email Address" />
        <div id="error3" class="error-message"></div>
      </div>

      <div class="input-box">
        <input type="password" id="password" name="password" placeholder="Password" />
        <span class="eye-icon" onclick="togglePassword('password')">👁️</span>
        <div id="error4" class="error-message"></div>
      </div>

      <div class="input-box">
        <input type="password" id="cPassword" name="cPassword" placeholder="Confirm Password" />
        <span class="eye-icon" onclick="togglePassword('cPassword')">👁️</span>
        <div id="error5" class="error-message"></div>
      </div>

      <input type="hidden" id="referralCode" name="referralCode" value="<%= locals.refCode ? refCode : '' %>" />

      <% if (locals.message && message.length > 0) { %>
        <div class="alert alert-danger text-center">
          <%= message %>
        </div>
      <% } %>

      <button type="submit">Create Account</button>
    </form>

    <a href="/auth/google" style="text-decoration: none;">
      <div class="google-btn">
        <img src="https://developers.google.com/identity/images/g-logo.png" width="20" />
        <span>Continue with Google</span>
      </div>
    </a>

    <div class="login-link">
      Already have an account?
      <a href="/login">Log in</a>
    </div>
  </div>

  <!-- JS -->
  <script src="/js/user/signup.js"></script>
</body>
</html>
