<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Order Details | DumbPhones</title>
  <link rel="stylesheet" href="/css/user/order-details.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
  <%- include("../partials/user/header") %>
  
  <div class="profile-wrapper">

    <!-- SIDEBAR -->
    <%- include("../../views/partials/user/sidebar.ejs") %>

    <main class="profile-content">
      
      <!-- BREADCRUMB -->
      <nav class="breadcrumb">
        <a href="/profile">Profile</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        <a href="/orders">My Orders</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        <span class="active">Order #<%= order.orderId %></span>
      </nav>

      <div class="orders-header">
        <h2>Order Details</h2>
        <p class="subtitle">Complete breakdown of order <strong>#<%= order.orderId %></strong></p>
      </div>

      <div class="order-details-grid">
        
        <!-- Left Column Items List -->
        <div class="main-column">
          <section class="details-section">
            <div class="section-header">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
              <h3>Purchased Items</h3>
            </div>

            <div class="items-list">
              <% order.orderedItems.forEach(item => { %>
                <div class="item-card">
                  <div class="item-img-wrap">
                    <img 
                      src="<%= item.variant?.variantImages?.[0]?.url || '/images/no-image.png' %>" 
                      alt="<%= item.product?.productName || 'Product Image' %>">
                  </div>
                  
                  <div class="item-info">
                    <h4 class="item-title"><%= item.product?.productName || "Product Unavailable" %></h4>
                    
                    <div class="item-meta">
                      <span class="meta-qty">Qty: <strong><%= item.quantity %></strong></span>
                      <span class="meta-calc">₹<%= parseInt(item.price).toLocaleString('en-IN') %> × <%= item.quantity %></span>
                      <% if (order.status === 'Returned') { %>
                        <span class="status-badge" style="margin-left:8px; font-size:0.75rem; background:#ef4444; color:white; padding: 2px 6px; border-radius: 4px;">Returned</span>
                      <% } else if (item.itemStatus === 'Cancelled') { %>
                        <span class="status-badge cancelled" style="margin-left:8px;font-size:0.75rem;">Cancelled</span>
                      <% } %>
                    </div>

                    <div class="item-total" style="display:flex; justify-content:space-between; align-items:center;">
                      <% if (item.itemStatus === 'Cancelled') { %>
                        <span style="text-decoration: line-through; color: #999;">₹<%= parseInt(item.price * item.quantity).toLocaleString('en-IN') %></span>
                      <% } else { %>
                        <span>₹<%= parseInt(item.price * item.quantity).toLocaleString('en-IN') %></span>
                      <% } %>
                      
                      <% if (item.itemStatus !== 'Cancelled' && (order.status === 'Pending' || order.status === 'Processing'|| order.status === 'Shipped')) { %>
                        <button type="button" class="btn btn-danger" style="padding:4px 8px; font-size:12px; height:auto;" onclick="cancelOrderItem('<%= order.orderId %>', '<%= item._id %>')">
                          Cancel Item
                        </button>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </section>
        </div>

        <!-- Right Column Order Summary & Actions -->
        <aside class="sidebar-column">
          
          <div class="summary-card">
            <div class="card-header-row">
              <h3>Order Summary</h3>
              <span class="status-badge <%= order.status.toLowerCase() %>"><%= order.status %></span>
            </div>

            <div class="summary-details">
              <div class="summary-line">
                <span class="label">Subtotal</span>
                <span class="value">₹<%= parseInt(order.totalPrice).toLocaleString('en-IN') %></span>
              </div>
              <div class="summary-line">
                <span class="label">Order Date</span>
                <span class="value"><%= order.createdOn.toDateString() %></span>
              </div>
              <div class="summary-line">
                <span class="label">Tax</span>
                <span class="value">₹<%= parseInt(order.tax).toLocaleString('en-IN') %></span>
              </div>
              <div class="summary-line">
                <span class="label">Shipping</span>
                <% if (order.shipping === 0) { %>
                  <span class="value" style="color: #10b981; font-weight: 600;">Free</span>
                <% } else { %>
                  <span class="value">₹<%= parseInt(order.shipping).toLocaleString('en-IN') %></span>
                <% } %>
              </div>
              <div class="summary-line discount-line">
                <span class="label">Discount Applied</span>
                <span class="value">- ₹<%= parseInt(order.discount).toLocaleString('en-IN') %></span>
              </div>
              <div class="summary-line" style="margin-top: 10px; border-top: 1px dashed #e2e8f0; padding-top: 10px;">
                <span class="label">Payment Method</span>
                <span class="value" style="font-weight: 600;"><%= order.paymentMethod || 'Unknown' %></span>
              </div>
              <div class="summary-line">
                <span class="label">Payment Status</span>
                <% if (order.paymentStatus === 'Paid') { %>
                  <span class="value" style="color: #10b981; font-weight: bold;"><%= order.paymentStatus %></span>
                <% } else if (order.paymentStatus === 'Pending') { %>
                  <span class="value" style="color: #f59e0b; font-weight: bold;"><%= order.paymentStatus %></span>
                <% } else { %>
                  <span class="value" style="color: #ef4444; font-weight: bold;"><%= order.paymentStatus %></span>
                <% } %>
              </div>
            </div>

            <div class="summary-total">
              <span class="label">Total Paid</span>
              <span class="value">₹<%= parseInt(order.finalAmount).toLocaleString('en-IN') %></span>
            </div>
          </div>

          <div class="actions-card">
            <h3>Available Actions</h3>
            
            <a href="/orders/<%= order.orderId %>/invoice" class="btn btn-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              Download Invoice
            </a>

            <% if (order.status === 'Pending' || order.status === 'Processing') { %>
              <button class="btn btn-danger" onclick="event.stopPropagation(); cancelOrder('<%= order.orderId %>')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                Cancel Order
              </button>
            <% } %>

            <% if (order.status === 'Delivered') { %>
              <button class="btn btn-warning" onclick="returnOrder('<%= order.orderId %>')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 14 4 9 9 4"></polyline><path d="M20 20v-7a4 4 0 0 0-4-4H4"></path></svg>
                Return Order
              </button>
            <% } %>
          </div>

        </aside>

      </div>
    </main>
  </div>

  <%- include("../partials/user/footer") %>

  <script src="/js/user/order-details.js"></script>
</body>
</html>
