<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Orders | DumbPhones</title>
  <link rel="stylesheet" href="/css/user/orders.css">
</head>
<body>

<%- include("../partials/user/header") %>

<div class="profile-wrapper">
  
  <!-- SIDEBAR -->
  <%- include("../../views/partials/user/sidebar.ejs") %>

  <!-- MAIN CONTENT -->
  <main class="profile-content">
    <div class="orders-header">
      <h2>My Orders</h2>
      <p class="subtitle">View and manage your recent purchases</p>
    </div>

    <!-- SEARCH BAR -->
    <div class="orders-actions-bar">
      <form action="/orders/search" method="GET" class="search-form">
        <div class="search-input-wrap">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" name="q" placeholder="Search by Order ID" value="<%= locals.q ? q : '' %>" required>
        </div>
        <button type="submit" class="btn-search">Search</button>
        <% if (locals.q) { %>
          <a href="/orders" class="btn-clear">Clear</a>
        <% } %>
      </form>
    </div>

    <!-- ORDERS LIST -->
    <div class="orders-list">
      <% if (orders.length === 0) { %>
        <div class="empty-orders-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
          <h3>No orders yet</h3>
          <p>You haven't placed any orders. Start exploring our premium collection.</p>
          <a href="/shop" class="btn btn-outline-primary">Start Shopping</a>
        </div>
      <% } else { %>
        <% orders.forEach(order => { %>
          <div class="order-card" onclick="window.location.href='/orders/<%= order.orderId %>'">
            
            <div class="order-card-header">
              <div class="order-id">
                <span class="label">Order ID</span>
                <strong>#<%= order.orderId %></strong>
              </div>
              <% if (order.paymentStatus === 'Failed' && order.status !== 'Cancelled') { %>
                <span class="status-badge" style="background:#fef2f2; color:#ef4444; border:1px solid #ef4444;">Payment Failed</span>
              <% } else { %>
                <span class="status-badge <%= order.status.toLowerCase() %>">
                  <%= order.status %>
                </span>
              <% } %>
            </div>

            <div class="order-card-body">
              <div class="order-meta">
                <div class="meta-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                  <span>
                    <%= order.invoiceDate ? order.invoiceDate.toDateString() : order.createdOn.toDateString() %>
                  </span>
                </div>
                <div class="meta-item amount">
                  <span class="label">Total Amount</span>
                  <%
                    let orderListDynamicFinal = order.finalAmount;
                  %>
                  <strong>₹<%= parseInt(orderListDynamicFinal).toLocaleString('en-IN') %></strong>
                </div>
              </div>
              <% if (order.orderedItems && order.orderedItems.length > 0) { %>
                <div style="font-size: 13px; color: #64748b; margin-top: 10px; display: flex; align-items: center; gap: 6px;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                  <span>Contains <%= order.orderedItems.length %> item<%= order.orderedItems.length > 1 ? 's' : '' %></span>
                </div>
              <% } %>
            </div>

            <div class="order-card-actions">
              <button class="btn btn-view" onclick="event.stopPropagation(); window.location.href='/orders/<%= order.orderId %>'">
                View Details
              </button>

              <% if (order.paymentStatus === 'Failed' && (order.status === 'Pending' || order.status === 'Payment Failed')) { %>
                <button class="btn btn-outline-primary" style="border-color:#10b981; color:#10b981;" onclick="event.stopPropagation(); retryPayment('<%= order.orderId %>')">
                  Retry Payment
                </button>
              <% } %>

              <% if (order.status === 'Pending' || order.status === 'Processing') { %>
                <button class="btn btn-cancel" onclick="event.stopPropagation(); cancelOrder('<%= order.orderId %>')">
                  Cancel Order
                </button>
              <% } %>

              <% if (order.status === 'Delivered') { %>
                <button class="btn btn-return" onclick="event.stopPropagation(); returnOrder('<%= order.orderId %>')">
                  Return Order
                </button>
              <% } %>
            </div>

          </div>
        <% }) %>
      <% } %>
    </div>
  </main>

</div>

<%- include("../partials/user/footer") %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/user/orders.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</body>
</html>