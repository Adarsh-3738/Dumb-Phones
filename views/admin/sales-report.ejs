<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sales Report</title>
  <link rel="stylesheet" href="/css/admin/category.css">
  <style>
    .stats-row { display: flex; gap: 20px; margin-bottom: 30px; }
    .stat-card { background: white; flex: 1; padding: 25px; border-radius: 8px; border: 1px solid #ddd; box-shadow: 0 4px 6px rgba(0,0,0,0.02); text-align: left; border-top: 4px solid #2a55ff; }
    .stat-card h3 { font-size: 13px; color: #64748b; margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 0.5px; }
    .stat-card .value { font-size: 32px; font-weight: 700; color: #0f172a; }

    .filter-bar { background: white; padding: 20px; border-radius: 8px; border: 1px solid #ddd; display: flex; align-items: flex-end; gap: 15px; flex-wrap: wrap; margin-bottom: 25px; }
    .filter-group { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 150px; }
    .filter-group label { font-size: 12px; color: #64748b; font-weight: 600; text-transform: uppercase; }
    
    .downloads { display: flex; gap: 10px; margin-left: auto; }
    .btn-doc { background: #2a55ff; color: white; text-decoration: none; padding: 10px 24px; border-radius: 6px; font-weight: 500; font-size: 14px; transition: 0.2s; border: 1px solid #2a55ff;}
    .btn-doc:hover { background: #1f45e6; }
    .btn-doc.pdf { background: white; color: #2a55ff; }
    .btn-doc.pdf:hover { background: #f1f3ff; }
  </style>
</head>
<body>

<%- include("../../views/partials/admin/header") %> 

<div class="container">
  <div style="margin-bottom: 30px;">
    <h2 style="margin:0; font-size: 24px; color: #0f172a;">Official Sales & Revenue</h2>
    <p style="margin: 5px 0 0 0; color: #64748b; font-size: 14px;">Monitor gross volume, active deductions, and complete line-item history.</p>
  </div>

  <!-- Stats -->
  <div class="stats-row">
    <div class="stat-card">
      <h3>Overall Sales</h3>
      <div class="value"><%= stats.totalOrdersCount %></div>
      <div style="font-size: 12px; color: #64748b; margin-top: 5px;">
        <%= stats.deliveredCount %> Delivered | <%= stats.returnedCount %> Returned
      </div>
    </div>
    <div class="stat-card">
      <h3>Net Revenue</h3>
      <div class="value">₹<%= stats.netRevenue.toLocaleString() %></div>
      <div style="font-size: 12px; color: #10b981; margin-top: 5px;">
        Received from delivered orders
      </div>
    </div>
    <div class="stat-card">
      <h3>Deductions (Discounts)</h3>
      <div class="value" style="color: #ea580c;">₹<%= stats.totalDiscount.toLocaleString() %></div>
      <div style="font-size: 12px; color: #64748b; margin-top: 5px;">
        Offers and coupons applied
      </div>
    </div>
    <div class="stat-card" style="border-top: 4px solid #ef4444;">
      <h3>Total Refunds</h3>
      <div class="value" style="color: #ef4444;">₹<%= stats.totalRefunded.toLocaleString() %></div>
      <div style="font-size: 12px; color: #ef4444; margin-top: 5px;">
        Returned order value refunded
      </div>
    </div>
  </div>

  <!-- Filter & Search -->
  <form class="filter-bar" action="/admin/sales-report" method="GET" id="filterForm" onsubmit="return validateCustomDates(event)">
    
    <div class="filter-group" style="max-width: 250px;">
      <label>Search Order ID</label>
      <input type="text" name="search" placeholder="Search Order ID..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
    </div>

    <div class="filter-group">
      <label>Date Filter</label>
      <select name="range" id="rangeSelect" onchange="toggleCustomDates()">
        <option value="daily" <%= range === 'daily' ? 'selected' : '' %>>1 Day (Today)</option>
        <option value="weekly" <%= range === 'weekly' ? 'selected' : '' %>>1 Week</option>
        <option value="monthly" <%= range === 'monthly' ? 'selected' : '' %>>1 Month</option>
        <option value="yearly" <%= range === 'yearly' ? 'selected' : '' %>>1 Year</option>
        <option value="custom" <%= range === 'custom' ? 'selected' : '' %>>Custom Range</option>
      </select>
    </div>

    <div class="filter-group custom-dates" style="display: <%= range==='custom'?'flex':'none' %>;">
      <label>Start Date</label>
      <input type="date" name="startDate" value="<%= startDate %>">
    </div>
    
    <div class="filter-group custom-dates" style="display: <%= range==='custom'?'flex':'none' %>;">
      <label>End Date</label>
      <input type="date" name="endDate" value="<%= endDate %>">
    </div>

    <button type="submit" class="btn-add">Apply</button>
    
    <% if (typeof searchQuery !== 'undefined' && searchQuery || range !== 'monthly') { %>
      <a href="/admin/sales-report" class="clear-btn" style="text-decoration:none;">Clear</a>
    <% } %>

    <div class="downloads">
      <a href="/admin/sales-report/pdf?range=<%= range %>&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" class="btn-doc pdf">↓ PDF</a>
      <a href="/admin/sales-report/excel?range=<%= range %>&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" class="btn-doc">↓ Excel</a>
    </div>
  </form>

  <!-- Table Container -->
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Order ID</th>
          <th style="width: 12%;">Date</th>
          <th style="width: 18%;">Customer</th>
          <th style="width: 12%;">Reg. Price Tot.</th>
          <th style="width: 12%;">Deductions</th>
          <th style="width: 14%;">Amount Paid</th>
          <th style="width: 12%;">Payment</th>
          <th style="width: 10%;">Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders.length === 0) { %>
          <tr><td colspan="8" style="text-align: center; padding: 40px; color: #94a3b8;">No Sales History Found for this Range.</td></tr>
        <% } %>
        <% orders.forEach(order => { %>
          <tr>
            <td><strong style="font-family: monospace; font-size: 11px; color: #475569; background: #f1f5f9; padding: 4px 6px; border-radius: 4px; word-break: break-all; display: block;"><%= order.orderId.toUpperCase() %></strong></td>
            <td style="color: #475569;"><%= new Date(order.createdOn).toLocaleDateString() %></td>
            <td style="color: #334155; font-weight: 500;"><%= order.userId ? order.userId.name : 'Guest' %></td>
            <td style="color:#64748b;">₹<%= order.totalPrice.toLocaleString() %></td>
            <td>
              <% if (order.couponApplied) { %>
                <span style="background:#fefce8; color:#a16207; border: 1px solid #fef08a; padding:2px 6px; border-radius:12px; font-size:10px; font-weight: 600; white-space:nowrap;">COUPON APPLIED</span>
              <% } %>
              <% if (order.discount > 0 && !order.couponApplied) { %>
                <span style="background:#f0fdf4; color:#15803d; border: 1px solid #bbf7d0; padding:2px 6px; border-radius:12px; font-size:10px; font-weight: 600; white-space:nowrap;">PRODUCT CATEGORY OFFERS</span>
              <% } else if (order.discount > 0) { %>
                 <!-- Stacked tag -->
              <% } else { %>
                <span style="color:#cbd5e1; font-size:12px;">—</span>
              <% } %>
              <% if(order.discount > 0) { %>
                <div style="margin-top:6px; font-size:13px; color:#ef4444; font-weight:bold;">- ₹<%= order.discount.toLocaleString() %></div>
              <% } %>
            </td>
            <td style="font-weight:700; color:#10b981; font-size: 15px;">
              <% if (order.status === 'Returned') { %>
                <span style="color: #ef4444; font-weight: bold;">Returned<br><span style="font-size: 11px; color: #64748b; font-weight: normal;">(₹<%= (order.refundedAmount || 0).toLocaleString() %> refunded)</span></span>
              <% } else { %>
                ₹<%= order.finalAmount.toLocaleString() %>
                <% if (order.refundedAmount && order.refundedAmount > 0) { %>
                  <br><span style="font-size: 11px; color: #64748b; font-weight: normal;">(₹<%= order.refundedAmount.toLocaleString() %> refunded)</span>
                <% } %>
              <% } %>
            </td>
            <td>
              <span style="font-size: 13px; font-weight: 600; color: #334155;"><%= order.paymentMethod %></span><br>
              <!-- <% if(order.paymentStatus === 'Paid') { %>
                <span style="font-size: 11px; color:#10b981; font-weight: bold;">[Paid]</span>
              <% } else if(order.paymentStatus === 'Pending') { %>
                <span style="font-size: 11px; color:#f59e0b; font-weight: bold;">[Pending]</span>
              <% } else { %>
                <span style="font-size: 11px; color:#ef4444; font-weight: bold;">[<%= order.paymentStatus %>]</span>
              <% } %> -->
            </td>
            <td>
              <% if (order.status === 'Delivered') { %>
                <span style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; text-transform: uppercase;"><%= order.status %></span>
              <% } else if (order.status === 'Returned') { %>
                <span style="background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; text-transform: uppercase;"><%= order.status %></span>
              <% } else { %>
                <span style="background: #f3f4f6; color: #4b5563; border: 1px solid #e5e7eb; padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; text-transform: uppercase;"><%= order.status %></span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <div class="pagination">
    <% for(let i=1; i<=totalPages; i++) { %>
      <a href="/admin/sales-report?page=<%= i %>&range=<%= range %>&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" class="<%= currentPage == i ? 'active page-btn' : 'page-btn' %>"><%= i %></a>
    <% } %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function toggleCustomDates() {
    const isCustom = document.getElementById("rangeSelect").value === "custom";
    document.querySelectorAll(".custom-dates").forEach(el => {
      el.style.display = isCustom ? "flex" : "none";
    });
  }

  function validateCustomDates(event) {
    const rangeSelect = document.getElementById("rangeSelect").value;
    if (rangeSelect === "custom") {
      const startDateNode = document.querySelector('input[name="startDate"]');
      const endDateNode = document.querySelector('input[name="endDate"]');
      
      if (!startDateNode.value || !endDateNode.value) {
        event.preventDefault();
        Swal.fire("Validation Error", "Please select both Start Date and End Date.", "warning");
        return false;
      }
      
      const start = new Date(startDateNode.value);
      const end = new Date(endDateNode.value);
      const today = new Date();
      today.setHours(23, 59, 59, 999);
      
      if (start > end) {
        event.preventDefault();
        Swal.fire("Validation Error", "Start Date cannot be after End Date.", "warning");
        return false;
      }
      
      if (end > today) {
        event.preventDefault();
        Swal.fire("Validation Error", "End Date cannot be in the future.", "warning");
        return false;
      }
    }
    return true;
  }
</script>
</body>
</html>
