<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sales Report</title>
  <style>
    body { background: #f8fafc; margin-left: 250px; font-family: sans-serif; }
    .container { padding: 30px; max-width: 1100px; }
    
    /* Stats Row */
    .stats-row { display: flex; gap: 20px; margin-bottom: 30px; }
    .stat-card { background: white; flex: 1; padding: 25px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center; }
    .stat-card h3 { font-size: 14px; color: #64748b; margin: 0 0 10px 0; }
    .stat-card .value { font-size: 28px; font-weight: bold; color: #0f172a; }

    /* Filter Bar */
    .filter-bar { background: white; padding: 20px; border-radius: 12px; margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); display: flex; align-items: flex-end; gap: 15px; }
    .filter-group { display: flex; flex-direction: column; gap: 5px; }
    .filter-group label { font-size: 12px; color: #64748b; font-weight: bold; }
    .filter-group select, .filter-group input { padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none; }
    .btn-filter { background: #2563eb; color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; height: fit-content;}
    
    /* Download Buttons */
    .downloads { display: flex; gap: 10px; margin-left: auto; }
    .btn-doc { background: #10b981; color: white; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-size: 14px;}
    .btn-doc.pdf { background: #ef4444; }

    /* Table */
    table { width: 100%; border-collapse: collapse; background: white; border-radius: 12px; overflow: hidden; }
    th, td { padding: 15px; text-align: left; border-bottom: 1px solid #e2e8f0; font-size: 14px; }
    th { background: #f1f5f9; color: #475569; }
    .pagination { margin-top: 20px; display: flex; gap: 5px; justify-content: center; }
    .pagination a { padding: 8px 12px; background: white; text-decoration: none; border-radius: 4px; border: 1px solid #cbd5e1; color: black; }
  </style>
</head>
<body>

<%- include("../../views/partials/admin/header") %> 

<div class="container">
  <h2 style="margin-bottom: 20px;">Sales Report</h2>

  <!-- Stats -->
  <div class="stats-row">
    <div class="stat-card">
      <h3>Overall Sales / Delivered</h3>
      <div class="value"><%= stats.salesCount %></div>
    </div>
    <div class="stat-card">
      <h3>Overall Revenue</h3>
      <div class="value">₹<%= stats.orderAmount.toLocaleString() %></div>
    </div>
    <div class="stat-card">
      <h3>Deductions (Coupons/Discounts)</h3>
      <div class="value" style="color: #ef4444;">₹<%= stats.totalDiscount.toLocaleString() %></div>
    </div>
  </div>

  <!-- Filter -->
  <form class="filter-bar" action="/admin/sales-report" method="GET" id="filterForm">
    <div class="filter-group">
      <label>Date Filter</label>
      <select name="range" id="rangeSelect" onchange="toggleCustomDates()">
        <option value="daily" <%= range === 'daily' ? 'selected' : '' %>>1 Day (Today)</option>
        <option value="weekly" <%= range === 'weekly' ? 'selected' : '' %>>1 Week</option>
        <option value="monthly" <%= range === 'monthly' ? 'selected' : '' %>>1 Month</option>
        <option value="yearly" <%= range === 'yearly' ? 'selected' : '' %>>1 Year</option>
        <option value="custom" <%= range === 'custom' ? 'selected' : '' %>>Custom Range</option>
      </select>
    </div>

    <div class="filter-group custom-dates" style="display: <%= range==='custom'?'flex':'none' %>;">
      <label>Start Date</label>
      <input type="date" name="startDate" value="<%= startDate %>">
    </div>
    
    <div class="filter-group custom-dates" style="display: <%= range==='custom'?'flex':'none' %>;">
      <label>End Date</label>
      <input type="date" name="endDate" value="<%= endDate %>">
    </div>

    <button type="submit" class="btn-filter">Generate Report</button>
    
    <div class="downloads">
      <!-- We preserve the applied filters in the download URLs! -->
      <a href="/admin/sales-report/pdf?range=<%= range %>&startDate=<%= startDate %>&endDate=<%= endDate %>" class="btn-doc pdf">↓ PDF</a>
      <a href="/admin/sales-report/excel?range=<%= range %>&startDate=<%= startDate %>&endDate=<%= endDate %>" class="btn-doc">↓ Excel</a>
    </div>
  </form>

  <!-- Table -->
  <table>
    <thead>
      <tr>
        <th>Order ID</th>
        <th>Date</th>
        <th>Customer</th>
        <th>Discount Used</th>
        <th>Final Amount</th>
      </tr>
    </thead>
    <tbody>
      <% if (orders.length === 0) { %>
        <tr><td colspan="5" style="text-align: center;">No Sales Found for this Range.</td></tr>
      <% } %>
      <% orders.forEach(order => { %>
        <tr>
          <td><strong style="font-family: monospace;"><%= order.orderId.substring(0,8) %></strong></td>
          <td><%= new Date(order.createdOn).toLocaleDateString() %></td>
          <td><%= order.userId ? order.userId.name : 'Unknown User' %></td>
          <td style="color:#ef4444;">- ₹<%= order.discount %></td>
          <td style="font-weight:bold; color:#10b981;">₹<%= order.finalAmount %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <!-- Pagination -->
  <div class="pagination">
    <% for(let i=1; i<=totalPages; i++) { %>
      <a href="/admin/sales-report?page=<%= i %>&range=<%= range %>&startDate=<%= startDate %>&endDate=<%= endDate %>" style="<%= currentPage == i ? 'background:#2563eb; color:white;' : '' %>"><%= i %></a>
    <% } %>
  </div>
</div>

<script>
  function toggleCustomDates() {
    const isCustom = document.getElementById("rangeSelect").value === "custom";
    document.querySelectorAll(".custom-dates").forEach(el => {
      el.style.display = isCustom ? "flex" : "none";
    });
  }
</script>
</body>
</html>
