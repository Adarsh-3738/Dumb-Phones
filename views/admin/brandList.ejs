<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Phone Brands</title>

  <style>
    body {
      margin: 0;
      font-family: "Inter", sans-serif;
      background: #f7f9fc;
      display: flex;
    }

    /* Sidebar */
    .sidebar {
      width: 240px;
      background: white;
      height: 100vh;
      padding: 20px 0;
      border-right: 1px solid #eee;
    }

    .sidebar h2 {
      font-size: 20px;
      padding-left: 20px;
      margin-bottom: 35px;
      color: #1f2937;
    }

    .menu-item {
      padding: 12px 20px;
      font-size: 15px;
      color: #6b7280;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .menu-item.active,
    .menu-item:hover {
      background: #eef2ff;
      color: #4338ca;
    }

    /* Main container */
    .main {
      flex-grow: 1;
      padding: 40px;
      margin-left:260px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      
    }

    .header h1 {
      font-size: 26px;
      margin: 0;
    }

    .btn {
      padding: 10px 20px;
      background: #2563eb;
      color: white;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-size: 15px;
    }
    .btn:hover {
      background: #1d4ed8;
    }

    /* Table styling */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 30px;
      background: white;
      border-radius: 10px;
      overflow: hidden;
    }

    thead {
      background: #f1f5f9;
      font-weight: 600;
    }

    th, td {
      padding: 16px;
      text-align: left;
      border-bottom: 1px solid #eee;
      font-size: 15px;
    }

    tr:hover {
      background: #f9fafb;
    }

    .action-btn {
      cursor: pointer;
      margin-right: 10px;
      font-size: 18px;
    }

    .text-link {
      color: #2563eb;
      text-decoration: underline;
      cursor: pointer;
    }

    .footer {
      margin-top: 20px;
      display: flex;
      justify-content: space-between;
      color: #6b7280;
      font-size: 14px;
    }

    .pagination button {
      padding: 8px 15px;
      border: 1px solid #d1d5db;
      background: white;
      cursor: pointer;
      border-radius: 6px;
      margin-left: 5px;
    }

    .pagination button:hover {
      background: #f3f4f6;
    }
  </style>
</head>

<body>

  <!-- Sidebar -->
  <%- include("../../views/partials/admin/header") %>

  <!-- Main Content -->
  <div class="main">
    <div class="header">
      <h1>Phone Brands</h1>
      <a href="/admin/brands/add">
        <button class="btn">+ New Brand</button>
      </a>
    </div>

    <!-- Brand Table -->
    <table>
      <thead>
        <tr>
          <th>Logo</th>
          <th>Brand Name</th>
          <th>Country</th>
          <th>Founded</th>
          <th>Website</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% brands.forEach(b => { %>
          <tr>
            <td><img src="<%= b.logo %>" width="40" /></td>
            <td><%= b.name %></td>
            <td><%= b.country %></td>
            <td><%= b.founded %></td>
            <td><a class="text-link" href="<%= b.website %>" target="_blank">Visit Site</a></td>
            <td>
              <a href="/admin/brand/view/<%= b._id %>" class="action-btn">👁</a>
              <a href="/admin/brand/delete/<%= b._id %>" class="action-btn">🗑</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="footer">
      <div>Showing 1 to <%= brands.length %> of <%= totalBrands %> results</div>

      <div class="pagination">
        <button>Previous</button>
        <button>Next</button>
      </div>
    </div>
  </div>

</body>
</html>
