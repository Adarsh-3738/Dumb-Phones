<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Phone Brands</title>
<link rel="stylesheet" href="/css/admin/brandList.css">
  
</head>

<body>

  <!-- Sidebar -->
  <%- include("../../views/partials/admin/header") %>

  <!-- Main Content -->
  <div class="main">
    <div class="header">
      <h1>Phone Brands</h1>
      <a href="/admin/brands/add">
        <button class="btn">+ New Brand</button>
      </a>
    </div>

    <!-- Brand Table -->
    <table>
      <thead>
        <tr>
          <th>Logo</th>
          <th>Brand Name</th>
          <th>Country</th>
          <th>Founded</th>
          <th>Website</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% brands.forEach(b => { %>
          <tr>
            <td><img src="<%= b.logo %>" width="40" /></td>
            <td><%= b.name %></td>
            <td><%= b.country %></td>
            <td><%= b.founded %></td>
            <td><a class="text-link" href="<%= b.website %>" target="_blank">Visit Site</a></td>
            <td>
              <a href="/admin/brand/view/<%= b._id %>" class="action-btn">👁</a>
              <a href="/admin/brand/delete/<%= b._id %>" class="action-btn">🗑</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="footer">
      <div>Showing 1 to <%= brands.length %> of <%= totalBrands %> results</div>

      <div class="pagination">
        <button>Previous</button>
        <button>Next</button>
      </div>
    </div>
  </div>

</body>
</html>
