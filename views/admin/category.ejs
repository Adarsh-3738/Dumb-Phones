<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Category Management</title>

  <link rel="stylesheet" href="/css/admin/category.css">
 
</head>

<body>

<%- include("../../views/partials/admin/header") %> 

<div class="container">
  
  <div class="title-box">
    <div>
      <h2>Category Management</h2>
      <p>Create and manage product categories.</p>
    </div>
    <button class="btn-add" onclick="openAddModal()">+ Add Category</button>
  </div>

  <!-- Search -->
  <div class="search-bar">
    <form method="GET" action="/admin/category">
      <input type="text" name="search" placeholder="Search category..." value="<%= searchQuery %>">
      <button class="btn-add" type="submit">Search</button>
    </form>

    <% if (searchQuery) { %>
      <a href="/admin/category"><button class="clear-btn">Clear</button></a>
    <% } %>
  </div>

  <!-- Categories Table -->
  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th>Status</th>
        <th>Created</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% if(categories.length === 0) { %>
        <tr><td colspan="4" style="text-align:center;padding:20px;">No categories found.</td></tr>
      <% } %>

      <% categories.forEach(cat => { %>
      <tr>
        <td><%= cat.name %></td>

        <td>
          <% if(cat.status === "Active") { %>
            <span class="status-active">Active</span>
          <% } else { %>
            <span class="status-draft">Draft</span>
          <% } %>
        </td>

        <td><%= cat.createdAt.toDateString() %></td>

        <td>
          <button
  class="action-btn btn-edit"
  onclick="openEditModal('<%= cat._id %>', '<%= cat.name %>', '<%= cat.status %>')"
>
  Edit
</button>

<button
  class="action-btn btn-delete"
  onclick="openDeleteModal('<%= cat._id %>')"
>
  Delete
</button>

        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <!-- Pagination -->
  <div class="pagination">
    <% if (currentPage > 1) { %>
      <a href="/admin/category?page=<%= currentPage - 1 %>&search=<%= searchQuery %>">
        <button class="page-btn">Prev</button>
      </a>
    <% } %>

    <% for(let i = 1; i <= totalPages; i++) { %>
      <a href="/admin/category?page=<%= i %>&search=<%= searchQuery %>">
        <button class="page-btn <%= i === currentPage ? 'active' : '' %>"><%= i %></button>
      </a>
    <% } %>

    <% if (currentPage < totalPages) { %>
      <a href="/admin/category?page=<%= currentPage + 1 %>&search=<%= searchQuery %>">
        <button class="page-btn">Next</button>
      </a>
    <% } %>
  </div>
</div>


<!-- ADD CATEGORY MODAL -->
<div class="modal-bg" id="addModal">
  <div class="modal-box">
    <h3>Add Category</h3>
    <input id="addName" placeholder="Category Name">
    <select id="addStatus">
      <option value="Active">Active</option>
      <option value="Draft">Draft</option>
    </select>

    <div class="modal-btns">
      <button class="btn btn-blue" onclick="submitAdd()">Add</button>
      <button class="btn btn-gray" onclick="closeAddModal()">Cancel</button>
    </div>
  </div>
</div>

<!-- EDIT CATEGORY MODAL -->
<div class="modal-bg" id="editModal">
  <div class="modal-box">
    <h3>Edit Category</h3>

    <input id="editName">
    <select id="editStatus">
      <option value="Active">Active</option>
      <option value="Draft">Draft</option>
    </select>

    <div class="modal-btns">
      <button class="btn btn-blue" onclick="submitEdit()">Save</button>
      <button class="btn btn-gray" onclick="closeEditModal()">Cancel</button>
    </div>
  </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-bg" id="deleteModal">
  <div class="modal-box">
    <h3>Delete Category?</h3>
    <p>This action cannot be undone.</p>

    <div class="modal-btns">
      <button class="btn btn-red" onclick="submitDelete()">Delete</button>
      <button class="btn btn-gray" onclick="closeDeleteModal()">Cancel</button>
    </div>
  </div>
</div>

<script src="/js/admin/category.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</body>
</html>
