<%- include("../../views/partials/admin/header") %>
<link rel="stylesheet" href="/css/admin/admin-error.css">

<div class="admin-error-container">
  <div class="admin-error-card">
    <div class="admin-error-icon">
      <i data-lucide="alert-triangle"></i>
    </div>
    <div class="error-code"><%= typeof statusCode !== 'undefined' ? statusCode : '404' %></div>
    <div class="error-title"><%= typeof title !== 'undefined' ? title : 'Page or Action Error' %></div>
    <p class="error-msg">
      <%= typeof message !== 'undefined' ? message : "The requested admin page or action could not be completed. Please check your URL or return to the dashboard." %>
    </p>
    <div class="btn-group">
      <a href="/admin/dashboard" class="btn-dash">
        <i data-lucide="arrow-left"></i> Back to Dashboard
      </a>
      <button onclick="history.back()" class="btn-back">
        <i data-lucide="rotate-ccw"></i> Go Back
      </button>
    </div>
  </div>
</div>

<script>
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>
