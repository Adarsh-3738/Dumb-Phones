<!DOCTYPE html>
<html>
<head>
  <title>Admin | Order Details</title>
  <link rel="stylesheet" href="/css/admin/order-details.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

<%- include("../partials/admin/header") %>

<div class="container">

  <h2>Order Details</h2>

  <!-- Order Summary -->
  <div class="card">
    <h3>Order Summary</h3>
    <p><strong>Order ID:</strong> <%= order.orderId %></p>
    <p><strong>Status:</strong> <span class="status"><%= order.status %></span></p>
    <p><strong>Date:</strong> <%= order.createdOn.toDateString() %></p>
    <p><strong>Total Amount:</strong> ₹<%= order.finalAmount %></p>

    <label>Change Status</label>
    <select onchange="updateStatus('<%= order.orderId %>', this.value)">
      <% ["Pending","Processing","Shipped","Out for Delivery","Delivered","Cancelled"].forEach(s => { %>
        <option value="<%= s %>" <%= order.status === s ? "selected" : "" %>>
          <%= s %>
        </option>
      <% }) %>
    </select>
  </div>

  <!-- User Info -->
  <div class="card">
    <h3>User Details</h3>
    <p><strong>Name:</strong> <%= order.userId?.name || "N/A" %></p>
    <p><strong>Email:</strong> <%= order.userId?.email || "N/A" %></p>
  </div>

  <!-- Address -->
  <!-- Address -->
<div class="card">
  <h3>Delivery Address</h3>

  <% if (order.address) { %>
    <p><strong>Name:</strong> <%= order.address.name %></p>
    <p><strong>Phone:</strong> <%= order.address.phone %></p>
    <p>
      <strong>Address:</strong><br>
      <%= order.address.addressType %>,<br>
      <%= order.address.landmark %>,<br>
      <%= order.address.city %>, <%= order.address.state %> - <%= order.address.pincode %>
    </p>
  <% } else { %>
    <p style="color:red;">Address not found for this order</p>
  <% } %>
</div>


  <!-- Ordered Items -->
  <div class="card">
    <h3>Ordered Products</h3>

    <table class="items-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Qty</th>
          <th>Price</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% order.orderedItems.forEach(item => { %>
          <tr>
            <td><%= item.product.productName %></td>
            <td><%= item.quantity %></td>
            <td>₹<%= item.price %></td>
            <td>₹<%= item.price * item.quantity %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <a href="/admin/orders" class="back-btn">← Back to Orders</a>

</div>

<script>
async function updateStatus(orderId, status) {
  const { isConfirmed } = await Swal.fire({
    title: "Update Order Status?",
    text: `Change status to "${status}"`,
    icon: "question",
    showCancelButton: true,
    confirmButtonColor: "#1d4ed8"
  });

  if (!isConfirmed) return;

  const res = await fetch(`/admin/orders/${orderId}/status`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ status })
  });

  if (res.ok) {
    Swal.fire("Updated!", "Order status updated", "success");
  } else {
    Swal.fire("Error", "Could not update status", "error");
  }
}
</script>

</body>
</html>
