 <!DOCTYPE html>
<html>
<head>
  <title>Admin | Order Details</title>
  <link rel="stylesheet" href="/css/admin/order-details.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

<%- include("../partials/admin/header") %>

<div class="container">

  <h2>Order Details</h2>

  <!-- Order Summary -->
  <div class="card">
    <h3>Order Summary</h3>
    <p><strong>Order ID:</strong> <%= order.orderId %></p>
    <p><strong>Status:</strong> <span class="status"><%= order.status %></span></p>
    <p><strong>Date:</strong> <%= order.createdOn.toDateString() %></p>
    <%
      let topActiveSubtotal = 0;
      order.orderedItems.forEach(item => {
        if (item.itemStatus !== 'Cancelled') {
          topActiveSubtotal += (item.price * item.quantity);
        }
      });
    %>
    <p><strong>Total Amount:</strong> ₹<%= order.finalAmount %></p>
    <p><strong>Payment Method:</strong> 
      <span style="background: #f1f5f9; padding: 2px 8px; border-radius: 4px; font-weight: 600; font-size: 13px; color: #334155;"><%= order.paymentMethod || 'Unknown' %></span>
    </p>
    <p><strong>Payment Status:</strong> 
      <% if (order.paymentStatus === 'Paid') { %>
        <span style="color: #10b981; font-weight: bold;"><%= order.paymentStatus %></span>
      <% } else if (order.paymentStatus === 'Pending') { %>
        <span style="color: #f59e0b; font-weight: bold;"><%= order.paymentStatus %></span>
      <% } else { %>
        <span style="color: #ef4444; font-weight: bold;"><%= order.paymentStatus %></span>
      <% } %>
    </p>
    <% if (order.cancelReason) { %>
      <div style="margin: 15px 0; padding: 10px; border-left: 4px solid #f59e0b; background-color: #fffbeb;">
        <strong>Cancel Reason:</strong> <%= order.cancelReason %>
      </div>
    <% } %>

    <% if (order.returnReason) { %>
      <div style="margin: 15px 0; padding: 10px; border-left: 4px solid #ef4444; background-color: #fef2f2;">
        <strong>Return Reason:</strong> <%= order.returnReason %>
      </div>
    <% } %>

    <% if (order.status === "Return Request") { %>
      <div style="margin-top: 20px; padding: 15px; border: 1px solid #fcd34d; background: #fffbeb; border-radius: 8px;">
        <h4 style="margin-top: 0; color: #b45309;">Verify Return Request</h4>
        <p style="font-size: 14px; color: #78350f; margin-bottom: 15px;">The user has requested to return this order. Approving it will automatically refund ₹<%= order.finalAmount %> into their Wallet and restore inventory.</p>
        <div style="display: flex; gap: 10px;">
          <button onclick="updateStatus('<%= order._id %>', 'Returned', '<%= order.status %>')" style="background: #10b981; color: white; padding: 10px 16px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">Approve Return</button>
          <button onclick="updateStatus('<%= order._id %>', 'Return Rejected', '<%= order.status %>')" style="background: #ef4444; color: white; padding: 10px 16px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">Reject Return</button>
        </div>
      </div>
    <% } else { %>
      <label>Change Status</label>
      <select onchange="updateStatus('<%= order._id %>', this.value, '<%= order.status %>', this)">
        <% ["Pending","Processing","Shipped","Out for Delivery","Delivered","Cancelled", "Return Request", "Returned", "Return Rejected"].forEach(s => { %>
          <option value="<%= s %>" <%= order.status === s ? "selected" : "" %>>
            <%= s %>
          </option>
        <% }) %>
      </select>
    <% } %>
  </div>

  <!-- User Info -->
  <div class="card">
    <h3>User Details</h3>
    <p><strong>Name:</strong> <%= order.userId?.name || "N/A" %></p>
    <p><strong>Email:</strong> <%= order.userId?.email || "N/A" %></p>
  </div>

  
  <!-- Address -->
<div class="card">
  <h3>Delivery Address</h3>

  <% if (order.address) { %>
    <p><strong>Name:</strong> <%= order.address.name %></p>
    <p><strong>Phone:</strong> <%= order.address.phone %></p>
    <p>
      <strong>Address:</strong><br>
      <%= order.address.addressType %>,<br>
      <%= order.address.landmark %>,<br>
      <%= order.address.city %>, <%= order.address.state %> - <%= order.address.pincode %>
    </p>
  <% } else { %>
    <p style="color:red;">Address not found for this order</p>
  <% } %>
</div>


  <!-- Ordered Items -->
  <div class="card">
    <h3>Ordered Products</h3>

    <table class="items-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Qty</th>
          <th>Price</th>
          <th>Total</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% order.orderedItems.forEach(item => { %>
          <tr>
            <td><%= item.product?.productName || "Product Unavailable" %></td>
            <td><%= item.quantity %></td>
            <td>₹<%= item.price %></td>
            <td style="<%= item.itemStatus === 'Cancelled' ? 'text-decoration: line-through; color: #999;' : '' %>">
              ₹<%= item.price * item.quantity %>
            </td>
            <td>
              <% if (item.itemStatus === 'Returned') { %>
                <span style="color: #ef4444; font-weight: bold; font-size: 0.85em;">Returned</span>
                <% if (item.returnReason) { %>
                  <div style="font-size: 0.75em; color: #b45309; margin-top: 4px;">Reason: <%= item.returnReason %></div>
                <% } %>
              <% } else if (item.itemStatus === 'Return Rejected') { %>
                <span style="color: #ef4444; font-weight: bold; font-size: 0.85em; text-decoration: line-through;">Return Rejected</span>
                <% if (item.returnReason) { %>
                  <div style="font-size: 0.75em; color: #b45309; margin-top: 4px;">Reason: <%= item.returnReason %></div>
                <% } %>
              <% } else if (item.itemStatus === 'Return Request') { %>
                <span style="color: #f59e0b; font-weight: bold; font-size: 0.85em;">Return Requested</span>
                <% if (item.returnReason) { %>
                  <div style="font-size: 0.75em; color: #b45309; margin-top: 4px;">Reason: <%= item.returnReason %></div>
                <% } %>
                <div style="margin-top: 8px; display: flex; gap: 4px; flex-direction: column;">
                  <button onclick="updateItemStatus('<%= order._id %>', '<%= item._id %>', 'Returned')" style="background: #10b981; color: white; padding: 4px 8px; font-size: 0.75em; border: none; border-radius: 4px; cursor: pointer;">Approve Return</button>
                  <button onclick="updateItemStatus('<%= order._id %>', '<%= item._id %>', 'Return Rejected')" style="background: #ef4444; color: white; padding: 4px 8px; font-size: 0.75em; border: none; border-radius: 4px; cursor: pointer;">Reject Return</button>
                </div>
              <% } else if (item.itemStatus === 'Cancelled') { %>
                <span style="color: red; font-weight: bold; font-size: 0.85em;">Cancelled</span>
                <% if (item.cancelReason) { %>
                  <div style="font-size: 0.75em; color: #b45309; margin-top: 4px;">Reason: <%= item.cancelReason %></div>
                <% } else if (order.cancelReason) { %>
                  <div style="font-size: 0.75em; color: #b45309; margin-top: 4px;">Reason: <%= order.cancelReason %></div>
                <% } %>
              <% } else { %>
                <span style="color: green; font-size: 0.85em;">Active</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    
    <div style="margin-top: 5px; text-align: right; font-size: 1.1em; color: #555;">
      <strong>Tax:</strong> ₹<%= order.tax %><br>
      <strong>Shipping:</strong> <%= order.shipping === 0 ? "Free" : `₹${order.shipping}` %><br>
      <strong>Discount:</strong> - ₹<%= order.discount %>
    </div>
    <div style="margin-top: 10px; text-align: right; font-size: 1.25em;">
        <strong>Subtotal:</strong> ₹<%= topActiveSubtotal %><br>
        <strong>Amount Paid:</strong> ₹<%= (order.paymentStatus === 'Paid' || order.paymentStatus === 'Refunded') ? order.finalAmount : 0 %><br>
        <strong>Payment Method:</strong> <%= order.paymentMethod %>
    </div>
  </div>

  <a href="/admin/orders" class="back-btn">← Back to Orders</a>

</div>
<script src="/js/admin/order-details.js"></script>
   
</body>
</html>
