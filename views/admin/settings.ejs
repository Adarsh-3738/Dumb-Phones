<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - Store Settings</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f3f6fb;
      margin: 0;
      color: #334155;
    }
    .settings-container {
      margin-left: 260px; /* Offset for sidebar */
      padding: 40px;
      max-width: 800px;
    }
    .settings-card {
      background: white;
      border-radius: 16px;
      padding: 40px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.05);
      border: 1px solid #eef2f6;
    }
    .settings-header {
      margin-bottom: 30px;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 20px;
    }
    .settings-header h2 {
      margin: 0;
      color: #1e3a8a;
      font-size: 24px;
      font-weight: 600;
    }
    .settings-header p {
      color: #64748b;
      margin-top: 8px;
      font-size: 15px;
    }
    .form-group {
      margin-bottom: 25px;
    }
    .form-group label {
      display: block;
      margin-bottom: 10px;
      font-weight: 600;
      color: #1e293b;
      font-size: 15px;
    }
    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      max-width: 400px;
    }
    .input-wrapper input {
      width: 100%;
      padding: 14px 45px 14px 18px;
      border: 1.5px solid #cbd5e1;
      border-radius: 10px;
      font-size: 16px;
      transition: all 0.2s ease;
      color: #334155;
    }
    .input-wrapper input:focus {
      outline: none;
      border-color: #2563eb;
      box-shadow: 0 0 0 4px rgba(37,99,235,0.1);
    }
    .input-wrapper .addon {
      position: absolute;
      right: 18px;
      color: #64748b;
      font-weight: 600;
      font-size: 16px;
    }
    .helper-text {
      color: #94a3b8;
      display: block;
      margin-top: 8px;
      font-size: 14px;
    }
    .btn-save {
      background: #2563eb;
      color: white;
      border: none;
      padding: 14px 30px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .btn-save:hover {
      background: #1d4ed8;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(37,99,235,0.2);
    }
    .alert {
      padding: 16px 20px;
      border-radius: 10px;
      margin-bottom: 25px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 15px;
    }
    .alert-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .alert-error { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
  <%- include("../../views/partials/admin/header") %>

  <div class="settings-container">
    <div class="settings-card">
      <div class="settings-header">
        <h2>Global Settings</h2>
        <p>Manage store-wide configurations and rules</p>
      </div>

      <% if (message) { %>
        <div class="alert alert-success">
          <i data-lucide="check-circle" style="width:20px;height:20px;"></i>
          <%= message %>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-error">
          <i data-lucide="alert-circle" style="width:20px;height:20px;"></i>
          <%= error %>
        </div>
      <% } %>

      <form action="/admin/settings/update" method="POST">
        <div class="form-group">
          <label for="taxRate">Global Tax Rate</label>
          <div class="input-wrapper">
            <input type="number" id="taxRate" name="taxRate" value="<%= settings.taxRate %>" step="0.01" min="0" max="100" required>
            <span class="addon">%</span>
          </div>
          <span class="helper-text">This percentage will be applied to all future order calculations.</span>
        </div>

        <button type="submit" class="btn-save">
          <i data-lucide="save" style="width:18px;height:18px;"></i> Save Settings
        </button>
      </form>
    </div>
  </div>
  
  <script>
    if(typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  </script>
</body>
</html>
