<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Panel Login</title>

  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fa;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: #1a1a1a;
    }

    .login-container {
      width: 100%;
      max-width: 420px;
      background: #ffffff;
      padding: 40px;
      border-radius: 14px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }

    .logo-section {
      display: flex;
      align-items: center;
      margin-bottom: 25px;
    }

    .logo-section img {
      width: 30px;
      height: 30px;
      margin-right: 10px;
    }

    h1 {
      font-size: 26px;
      margin: 0;
      font-weight: bold;
      color: #111827;
    }

    p.subtext {
      color: #6b7280;
      margin: 8px 0 30px;
      font-size: 15px;
    }

    label {
      font-size: 14px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 6px;
      display: block;
    }

    input {
      width: 100%;
      padding: 14px;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      font-size: 14px;
      outline: none;
      margin-bottom: 18px;
      background: #f9fafb;
      color: #111;
    }

    .password-wrapper {
      position: relative;
    }

    .password-wrapper img {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 22px;
      cursor: pointer;
      opacity: 0.6;
    }

    .remember {
      display: flex;
      align-items: center;
      margin-bottom: 22px;
    }

    .remember input {
      width: 16px;
      height: 16px;
      margin-right: 8px;
    }

    .remember label {
      margin: 0;
      font-weight: normal;
      color: #374151;
    }

    button {
      width: 100%;
      padding: 14px;
      background: #2563eb;
      border: none;
      color: white;
      font-size: 16px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: bold;
      transition: 0.2s ease;
    }

    button:hover {
      background: #1d4ed8;
    }
  </style>
</head>

<body>

  <div class="login-container">

    <div class="logo-section">
      <img src="/images/logo.png" alt="logo">
      <strong>Dumb Phones</strong>
    </div>

    <h1>Admin Panel Login</h1>
    <p class="subtext">Welcome back! Please enter your details.</p>

    <form action="/admin/login" method="POST">
      <label>Email Address</label>
      <input type="email" name="email" placeholder="Enter your email" required />

      <label>Password</label>
      <div class="password-wrapper">
        <input type="password" name="password" placeholder="Enter your password" required />
        <img src="/images/eye.png" alt="toggle">
      </div>

      <div class="remember">
        <input type="checkbox" id="remember">
        <label for="remember">Remember me</label>
      </div>

      <button type="submit">Log In</button>
    </form>
  </div>

</body>
</html>
