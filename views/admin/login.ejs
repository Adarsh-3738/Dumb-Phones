<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Panel Login</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin/login.css">
</head>

<body>

<div class="login-container">

  <div class="logo-section">
    <img src="/images/logo.png" alt="logo">
    <strong>Dumb Phones</strong>
  </div>

  <h1>Admin Panel Login</h1>
  <p class="subtext">Welcome back! Please enter your details.</p>

  <% if (error) { %>
    <p class="error-message"><%= error %></p>
  <% } %>

  <form id="loginForm" action="/admin/login" method="POST" novalidate>
    <label>Email Address</label>
    <input 
      type="email" 
      id="email"
      name="email" 
      placeholder="Enter your email" 
      required 
    />
    <small class="error" id="emailError"></small>

    <label>Password</label>
    <div class="password-wrapper">
      <input 
        type="password" 
        id="password" 
        name="password" 
        placeholder="Enter your password" 
        required 
      />
      <i class="fa-solid fa-eye" id="toggleEye" aria-label="Toggle password visibility"></i>

    </div>
    <small class="error" id="passwordError"></small>

    <button type="submit">Log In</button>
  </form>

</div>

<script src="/js/admin/login.js"></script>
</body>
</html>
