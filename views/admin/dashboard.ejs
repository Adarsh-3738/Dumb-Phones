<!-- header -->
<%-include("../../views/partials/admin/header")%> 

<!-- Add robust Chart.js library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- Custom Dashboard CSS -->
<link rel="stylesheet" href="/css/admin/dashboard.css">

  <!-- Main Content -->
  <div class="main">

    <div class="topbar">
      <div>
        <h1>Admin Overview</h1>
        <p class="welcome-text">Here is what's happening in your store today.</p>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="cards">
      
      <!-- Revenue Card -->
      <div class="card animate-up delay-1">
        <div class="card-icon">
          <i data-lucide="dollar-sign"></i>
        </div>
        <h4>Total Revenue</h4>
        <h2>₹<%= totalRevenue.toLocaleString('en-IN') %></h2>
        <div class="metrics-row">
          <span class="badge badge-success"><i data-lucide="trending-up" style="width: 12px; height: 12px;"></i> Lifetime</span>
        </div>
      </div>

      <!-- Sales/Orders Card -->
      <div class="card animate-up delay-2">
        <div class="card-icon" style="background: #fef3c7; color: #d97706;">
          <i data-lucide="shopping-bag"></i>
        </div>
        <h4>Total Orders</h4>
        <h2><%= salesCount %></h2>
        <div class="metrics-row">
          <span class="badge badge-success"><i data-lucide="activity" style="width: 12px; height: 12px;"></i> All-Time</span>
        </div>
      </div>

      <!-- Users Card -->
      <div class="card animate-up delay-3">
        <div class="card-icon" style="background: #fce7f3; color: #db2777;">
          <i data-lucide="users"></i>
        </div>
        <h4>Total Customers</h4>
        <h2><%= usersCount %></h2>
        <div class="metrics-row">
          <span class="badge badge-success"><i data-lucide="user-check" style="width: 12px; height: 12px;"></i> Active Base</span>
        </div>
      </div>

      <!-- Products Card -->
      <div class="card animate-up delay-4">
        <div class="card-icon" style="background: #dcfce7; color: #16a34a;">
          <i data-lucide="package"></i>
        </div>
        <h4>Available Products</h4>
        <h2><%= productsCount %></h2>
        <div class="metrics-row">
          <span class="badge badge-warning"><i data-lucide="box" style="width: 12px; height: 12px;"></i> Catalog</span>
        </div>
      </div>

    </div>

    <!-- Charts Grid -->
    <div class="dashboard-grid animate-up delay-3">
      
      <!-- Revenue Chart -->
      <div class="chart-box">
        <div class="chart-header" style="display:flex; justify-content:space-between; align-items:center;">
          <h3 id="revenueChartTitle">Monthly Revenue (<%= new Date().getFullYear() %>)</h3>
          <select id="chartFilter" class="filter-select" onchange="fetchChartData()">
            <option value="monthly" selected>Monthly</option>
            <option value="weekly">Weekly</option>
            <option value="yearly">Yearly</option>
          </select>
        </div>
        <div class="chart-container-large">
          <canvas id="revenueChart"></canvas>
        </div>
      </div>

      <!-- Order Status Split -->
      <div class="chart-box">
        <div class="chart-header">
          <h3>Order Status Distribution</h3>
        </div>
        <div class="chart-container-small">
          <canvas id="statusChart"></canvas>
        </div>
      </div>
      
    </div>

    <!-- Recent Orders Table -->
    <div class="recent-orders animate-up delay-4">
      <div class="recent-orders-header">
        <h3>Recent Transactions</h3>
      </div>
      
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Customer</th>
              <th>Date</th>
              <th>Amount</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentOrders && recentOrders.length > 0) { %>
              <% recentOrders.forEach(order => { %>
                <tr>
                  <td><span style="font-family: monospace; color: var(--primary); font-weight: 500;">#<%= order.orderId ? order.orderId.substring(0,8) : 'N/A' %></span></td>
                  <td>
                    <div class="customer-info">
                      <span class="customer-name"><%= order.userId ? order.userId.name : 'Unknown User' %></span>
                      <span class="customer-email"><%= order.userId ? order.userId.email : 'N/A' %></span>
                    </div>
                  </td>
                  <td><%= new Date(order.createdOn).toLocaleDateString() %></td>
                  <td class="order-amount">₹<%= order.finalAmount.toLocaleString('en-IN') %></td>
                  <td>
                    <% 
                      let statusClass = 'status-pending';
                      if(order.status === 'Delivered') statusClass = 'status-delivered';
                      else if(order.status === 'Shipped' || order.status === 'Out for Delivery') statusClass = 'status-shipped';
                      else if(order.status === 'Processing') statusClass = 'status-processing';
                      else if(order.status === 'Cancelled') statusClass = 'status-cancelled';
                      else if(order.status === 'Returned' || order.status === 'Return Request') statusClass = 'status-returned';
                    %>
                    <span class="status-badge <%= statusClass %>"><%= order.status %></span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2rem;">No recent orders found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Best Sellers Grids -->
    <div class="best-sellers-grid animate-up delay-5" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 2rem; margin-bottom: 2rem;">
      <!-- Products -->
      <div class="best-seller-card chart-box" style="margin-bottom: 0;">
        <div class="chart-header">
          <h3>Top 10 Products</h3>
        </div>
        <ul class="best-seller-list" style="list-style: none; padding: 0; margin-top: 15px;">
          <% if (topProducts && topProducts.length > 0) { %>
            <% topProducts.forEach((item, index) => { %>
              <li style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #e2e8f0;">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span class="rank-badge" style="background: <%= index < 3 ? '#fef3c7' : '#f1f5f9' %>; color: <%= index < 3 ? '#d97706' : '#64748b' %>; font-weight: bold; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px;">#<%= index + 1 %></span>
                  <span class="bs-name" style="font-weight: 500; color: #1e293b;"><%= item.name %></span>
                </div>
                <span class="bs-sales" style="font-size: 14px; color: #10b981; font-weight: 600;"><%= item.totalSold %> sold</span>
              </li>
            <% }) %>
          <% } else { %>
            <p style="padding: 15px 0; color: #64748b; text-align: center;">No products sold yet.</p>
          <% } %>
        </ul>
      </div>

      <!-- Categories -->
      <div class="best-seller-card chart-box" style="margin-bottom: 0;">
        <div class="chart-header">
          <h3>Top 10 Categories</h3>
        </div>
        <ul class="best-seller-list" style="list-style: none; padding: 0; margin-top: 15px;">
          <% if (topCategories && topCategories.length > 0) { %>
            <% topCategories.forEach((item, index) => { %>
              <li style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #e2e8f0;">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span class="rank-badge" style="background: <%= index < 3 ? '#fef3c7' : '#f1f5f9' %>; color: <%= index < 3 ? '#d97706' : '#64748b' %>; font-weight: bold; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px;">#<%= index + 1 %></span>
                  <span class="bs-name" style="font-weight: 500; color: #1e293b;"><%= item.name %></span>
                </div>
                <span class="bs-sales" style="font-size: 14px; color: #10b981; font-weight: 600;"><%= item.totalSold %> sold</span>
              </li>
            <% }) %>
          <% } else { %>
            <p style="padding: 15px 0; color: #64748b; text-align: center;">No categories sold yet.</p>
          <% } %>
        </ul>
      </div>

      <!-- Brands -->
      <div class="best-seller-card chart-box" style="margin-bottom: 0;">
        <div class="chart-header">
          <h3>Top 10 Brands</h3>
        </div>
        <ul class="best-seller-list" style="list-style: none; padding: 0; margin-top: 15px;">
          <% if (topBrands && topBrands.length > 0) { %>
            <% topBrands.forEach((item, index) => { %>
              <li style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #e2e8f0;">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span class="rank-badge" style="background: <%= index < 3 ? '#fef3c7' : '#f1f5f9' %>; color: <%= index < 3 ? '#d97706' : '#64748b' %>; font-weight: bold; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px;">#<%= index + 1 %></span>
                  <span class="bs-name" style="font-weight: 500; color: #1e293b;"><%= item.name %></span>
                </div>
                <span class="bs-sales" style="font-size: 14px; color: #10b981; font-weight: 600;"><%= item.totalSold %> sold</span>
              </li>
            <% }) %>
          <% } else { %>
            <p style="padding: 15px 0; color: #64748b; text-align: center;">No brands sold yet.</p>
          <% } %>
        </ul>
      </div>
    </div>

  </div> <!-- End Main -->
<!--  Passed Data from Controller  -->
  <script>
    const rawMonthlyData = <%- monthlyData || '[]' %>;
    const rawStatusLabels = <%- statusLabels || '[]' %>;
    const rawStatusCounts = <%- statusCounts || '[]' %>;
</script>
 <script src="/js/admin/dashboard.js"></script>

</body>
</html>
