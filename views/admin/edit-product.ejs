<%- include("../partials/admin/header.ejs") %>

<link rel="stylesheet" href="/css/admin/edit-product.css">
<link rel="stylesheet"
  href="https://unpkg.com/cropperjs@1.6.1/dist/cropper.min.css"
/>

<div class="product-modal">
  <div class="modal-content">

    <!-- HEADER -->
    <div class="modal-header">
      <h3>Edit Product</h3>
      <span onclick="window.history.back()" class="close-btn">&times;</span>
    </div>




    
    <!-- FORM -->
    <form
    id="editProductForm"
      action="/admin/products/edit/<%= product._id %>?_method=PATCH"
      method="POST"
      enctype="multipart/form-data"
    >

      <!-- BASIC INFO -->
      <div class="form-section">
        <label>Product Name</label>
        <input
          type="text"
          name="productName"
          value="<%= product.productName %>"
          required
        />

        <label>Description</label>
        <textarea name="description" required><%= product.description %></textarea>

        <label>Brand</label>
        <select name="brand" required>
  <% brands.forEach(b => { %>
    <option
      value="<%= b._id %>"
      <%= String(b._id) === String(product.brand) || 
          String(b._id) === String(product.brand?._id) 
          ? "selected" : "" %>
    >
      <%= b.name %>
    </option>
  <% }) %>
</select>

        <label>Category</label>
        <select name="category" required>
          <% categories.forEach(c => { %>
            <option
              value="<%= c._id %>"
              <%= c._id.toString() === product.category._id.toString() ? "selected" : "" %>
            >
              <%= c.name %>
            </option>
          <% }) %>
        </select>

      </div>
      
      <hr />

      <!-- VARIANTS -->
      <h4>Variant Details</h4>
      
      <button type="button" id="addVariantBtn" class="add-btn" style="margin-bottom: 15px; margin-top: 10px;">+ Add Variant</button>

      <div id="variantsContainer">

        <% if (variants && variants.length > 0) { %>
          <% variants.forEach((variant, index) => { %>

            <div class="variant-card" data-index="<%= index %>">

              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 15px;">
                <h5 style="margin:0;">Variant <%= index + 1 %></h5>
                <button type="button" class="remove-variant-btn" style="background:#ef4444; color:white; border:none; border-radius:4px; padding:4px 8px; cursor:pointer;" onclick="this.closest('.variant-card').remove(); updateVariantNumbers();">Remove</button>
              </div>

              <!-- Hidden Variant ID -->
              <input
                type="hidden"
                name="variants[<%= index %>][_id]"
                value="<%= variant._id %>"
              />

              <label>Color</label>
              <input
                type="text"
                name="variants[<%= index %>][color]"
                value="<%= variant.color %>"
                required
              />

              <label>Regular Price</label>
              <input
                type="number"
                class="regularPrice"
                name="variants[<%= index %>][regularPrice]"
                value="<%= variant.regularPrice %>"
                required
              />

              <label>Sales Price</label>
              <input
                type="number"
                class="salesPrice"
                name="variants[<%= index %>][salesPrice]"
                value="<%= variant.salesPrice %>"
                required
              />

              <label>Quantity</label>
              <input
                type="number"
                class="quantity"
                name="variants[<%= index %>][quantity]"
                value="<%= variant.quantity %>"
                required
              />

              <!-- EXISTING IMAGES -->
              <div class="image-grid">
                <% if (variant.variantImages?.length) { %>
                  <% variant.variantImages.forEach(img => { %>
                    <div class="image-box">
                      <img src="<%= img.url %>" />
                      <button
                        type="button"
                        class="remove-img-btn"
                        onclick="removeImage('<%= variant._id %>', '<%= img.url %>', this)"
                      >
                        ×
                      </button>
                    </div>
                  <% }) %>
                <% } %>
              </div>

              <!-- ADD NEW IMAGES -->
              <label>Add New Images</label>
              <input
                type="file"
                class="variant-image-input"
                data-index="<%= index %>"
                name="variants[<%= index %>][images]"
                multiple
                accept="image/jpeg, image/png, image/webp"
              />
              <div class="preview-grid" style="display:flex;gap:8px;margin-top:10px;"></div>

            </div>

          <% }) %>
        <% } else { %>
          <p class="no-variants">No variants found</p>
        <% } %>

      </div>

      <!-- BUTTONS -->
      <button type="submit" class="submit-btn">
        Update Product
      </button>

      <button
        type="button"
        class="cancel-btn"
        onclick="window.history.back()"
      >
        Cancel
      </button>

    </form>

  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://unpkg.com/cropperjs@1.6.1/dist/cropper.min.js"></script>
<script src="/js/admin/edit-product.js"></script>

<%- include("../partials/admin/footer.ejs") %>