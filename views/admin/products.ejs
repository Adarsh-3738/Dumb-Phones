<%- include("../partials/admin/header.ejs") %>

<!-- Cropper.js -->
<link
  rel="stylesheet"
  href="https://unpkg.com/cropperjs@1.6.1/dist/cropper.min.css"
/>

<link rel="stylesheet" href="/css/admin/products.css">

<!-- HEADER -->
<div class="card-header">
  <h2>Products</h2>
  <button
  type="button"
  class="add-btn"
  onclick="openModal()"
>
  + Add Product
</button>
</div>
<% const safeSearch = search || "" %>

<form action="/admin/products" method="get" class="search-form" style="display:flex;gap:8px;">
  <input
    type="text"
    name="search"
    placeholder="Search products..."
    value="<%= safeSearch %>"
  />

  <button type="submit">Search</button>

  <% if (safeSearch) { %>
    <a href="/admin/products" class="clear-btn">Clear</a>
  <% } %>
</form>

<!-- PRODUCT LIST -->
<div class="card">
  <table>
    <thead>
      <tr>
        <th>Image</th>
        <th>Name</th>
        <th>Brand</th>
        <th>Category</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(product => { %>
        <tr>
       <td>
  <% 
    const firstVariant = product.variants?.[0];
    const firstImage = firstVariant?.variantImages?.[0];
  %>

  <% if (firstImage) { %>
    <img
      src="<%= firstImage.url %>"
      style="width:60px;height:60px;object-fit:cover;border-radius:6px;"
    />
  <% } else { %>
    <span style="color:#9ca3af;">No Image</span>
  <% } %>
</td>






 



          <td><%= product.productName %></td>
          <td><%= product.brand?.name %></td>
          <td><%= product.category?.name %></td>
          <!-- <td><%= product.isDeleted ? "Inactive" : "Active" %></td> -->
      <td>
      <span class="<%= product.isBlocked ? 'status-inactive' : 'status-active' %>">
  <%= product.isBlocked ? "Inactive" : "Active" %>
       </span>
      </td>



     <td>
  <a href="/admin/products/edit/<%= product._id %>" class="edit-btn">
    Edit
  </a>

  <% if (!product.isBlocked) { %>
   <button
  type="button"
  class="delete-btn"
  onclick="openStatusModal(
    '<%= product._id %>',
    '<%= currentPage %>',
    '<%= safeSearch %>',
    'Active'
  )"
>
  Deactivate
</button>


  <% } else { %>
   <button
  type="button"
  class="restore-btn"
  onclick="openStatusModal(
    '<%= product._id %>',
    '<%= currentPage %>',
    '<%= safeSearch %>',
    'Inactive'
  )"
>
  Activate
</button>


  <% } %>
</td>


        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- pagination -->

<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="?page=<%= currentPage - 1 %>&search=<%= safeSearch %>">Prev</a>
  <% } %>

  <% for (let i = 1; i <= totalPages; i++) { %>
    <a
      href="?page=<%= i %>&search=<%= safeSearch %>"
      class="<%= currentPage === i ? 'active' : '' %>"
    >
      <%= i %>
    </a>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <a href="?page=<%= currentPage + 1 %>&search=<%= safeSearch %>">Next</a>
  <% } %>
</div>



<!-- ADD PRODUCT MODAL -->
<div id="productModal" class="modal product-modal">
  <div class="modal-content">

    <div style="display:flex; justify-content:space-between; align-items:center;">
      <h3>Add Product</h3>
      <span onclick="closeModal()" style="cursor:pointer;font-size:22px;">&times;</span>
    </div>

    <form id="addProductForm"
          action="/admin/products/add-product"
          method="POST"
          enctype="multipart/form-data">

      <label>Product Name</label>
      <input type="text" name="productName"  />

      <label>Description</label>
      <textarea name="description" ></textarea>

      <label>Brand</label>
      <select name="brand" >
        <% brands.forEach(b => { %>
          <option value="<%= b._id %>"><%= b.name %></option>
        <% }) %>
      </select>

      <label>Category</label>
      <select name="category" >
        <% categories.forEach(c => { %>
          <option value="<%= c._id %>"><%= c.name %></option>
        <% }) %>
      </select>

      <hr/>
      <h4>Variant Details</h4>
      
      <button type="button" id="addVariantBtn" class="add-btn" style="margin-bottom: 15px; margin-top: 10px;">+ Add Variant</button>

      <div id="variantsContainer"></div>

      <button type="submit" class="submit-btn">
        Save Product
      </button>

    </form>

  </div>
</div>








<!-- Cropper.js JS  -->
<script src="https://unpkg.com/cropperjs@1.6.1/dist/cropper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/js/admin/products.js"></script>
<%- include("../partials/admin/footer.ejs") %>




