<%- include("../partials/admin/header.ejs") %>

<!-- Cropper.js -->
<link
  rel="stylesheet"
  href="https://unpkg.com/cropperjs@1.6.1/dist/cropper.min.css"
/>

<link rel="stylesheet" href="/css/admin/products.css">

<!-- HEADER -->
<div class="card-header">
  <h2>Products</h2>
  <button class="add-btn" onclick="openModal()">+ Add Product</button>
</div>
<form action="/admin/products" method="get" class="search-form">
  <input type="text"
         name="search"
         placeholder="Search products..."
         value="<%= search %>">
  <button type="submit">Search</button>
</form>

<!-- PRODUCT LIST -->
<div class="card">
  <table>
    <thead>
      <tr>
        <th>Image</th>
        <th>Name</th>
        <th>Brand</th>
        <th>Category</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(product => { %>
        <tr>
          <td>
  <% if (product.productImage && product.productImage.length > 0) { %>
    <img 
      src="<%= product.productImage[0].url %>" 
      alt="product image"
      style="width:60px;height:60px;object-fit:cover;border-radius:6px;"
    />
  <% } else { %>
    <span>No Image</span>
  <% } %>
</td>



          <td><%= product.productName %></td>
          <td><%= product.brand?.name %></td>
          <td><%= product.category?.name %></td>
          <!-- <td><%= product.isDeleted ? "Inactive" : "Active" %></td> -->
      <td>
      <span class="<%= product.isBlocked ? 'status-inactive' : 'status-active' %>">
  <%= product.isBlocked ? "Inactive" : "Active" %>
       </span>
      </td>



     <td>
  <a href="/admin/products/edit/<%= product._id %>" class="edit-btn">
    Edit
  </a>

  <% if (!product.isBlocked) { %>
    <button
      class="delete-btn"
      onclick="openStatusModal('<%= product._id %>', 'deactivate')"
    >
      Deactivate
    </button>
  <% } else { %>
    <button
      class="restore-btn"
      onclick="openStatusModal('<%= product._id %>', 'activate')"
    >
      Activate
    </button>
  <% } %>
</td>


        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- pagination -->

<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="?page=<%= currentPage - 1 %>&search=<%= search %>">Prev</a>
  <% } %>

  <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="?page=<%= i %>&search=<%= search %>"
       class="<%= currentPage === i ? 'active' : '' %>">
      <%= i %>
    </a>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <a href="?page=<%= currentPage + 1 %>&search=<%= search %>">Next</a>
  <% } %>
</div>


<!-- ADD PRODUCT MODAL -->
<div id="productModal" class="modal">
  <div class="modal-content">
    <!-- Modal Header -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
      <h3 style="color:#1e40af; margin:0;">Add Product</h3>
      <span class="close" onclick="closeModal()" style="font-size:22px; cursor:pointer; color:#1e3a8a;">&times;</span>
    </div>

    <form action="/admin/products/add-product" method="POST" enctype="multipart/form-data">
      
      <!-- Input Fields -->
      <label>Product Name</label>
      <input type="text" name="productName" required />

      <label>Regular Price</label>
      <input type="number" name="regularPrice" min="1" required />

      <label>Sales Price</label>
      <input type="number" name="salesPrice" min="1" required />

      <label>Color</label>
      <input type="text" name="color" required />

      <label>Stock Quantity</label>
      <input type="number" name="quantity" min="1" placeholder="Enter available stock" required />

      <label>Description</label>
      <textarea name="description" required></textarea>

      <label>Brand</label>
      <select name="brand" required>
        <% brands.forEach(b => { %>
          <option value="<%= b._id %>"><%= b.name %></option>
        <% }) %>
      </select>

      <label>Category</label>
      <select name="category" required>
        <% categories.forEach(c => { %>
          <option value="<%= c._id %>"><%= c.name %></option>
        <% }) %>
      </select>

      <!-- Image Upload & Crop -->
      <label>Images (Min 3)</label>
      <input type="file" id="imageInput" name="images" accept="image/*" multiple required />

      <img id="previewImage" style="border:1px solid #cbd5e1; border-radius:8px; max-width:100%; margin:10px 0; display:none;" />

      <button type="button" id="cropNextBtn" class="submit-btn" style="background:#2563eb; margin-bottom:15px;">
        Crop & Next
      </button>

      <!-- Cropped Images Preview Grid -->
      <div style="margin-top:10px;">
        <label style="font-weight:500; color:#1e40af;">Selected Images Preview</label>
        <div id="croppedPreviewGrid" style="display:flex; gap:10px; flex-wrap:wrap; margin-top:10px;"></div>
      </div>

      <!-- Save Button -->
      <button type="submit" class="submit-btn" style="background:#1e40af;">Save Product</button>
    </form>
  </div>
</div>






<!-- STATUS CONFIRM MODAL -->
<div id="statusModal" class="modal">
  <div class="modal-content" style="max-width:420px;">
    <h3 id="statusTitle" style="color:#1e40af;">Confirm Action</h3>
    <p id="statusMessage" style="margin:15px 0;color:#374151;">
      Are you sure?
    </p>

    <div style="display:flex;gap:10px;">
      <button
        id="confirmStatusBtn"
        class="submit-btn"
        style="background:#2563eb;"
      >
        Yes, Confirm
      </button>

      <button
        onclick="closeStatusModal()"
        class="submit-btn"
        style="background:#ffffff;color:#2563eb;border:1px solid #2563eb;"
      >
        Cancel
      </button>
    </div>
  </div>
</div>

<!-- Cropper.js JS (unchanged) -->
<script src="https://unpkg.com/cropperjs@1.6.1/dist/cropper.min.js"></script>

<script src="/js/admin/products.js"></script>
<%- include("../partials/admin/footer.ejs") %>




