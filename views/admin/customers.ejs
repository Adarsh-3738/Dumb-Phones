<%- include("../../views/partials/admin/header") %>
<link rel="stylesheet" href="/css/admin/customers.css">
<div class="page-wrapper">

    <h2 class="page-title">User Management</h2>

    <!-- Search -->
    <div class="search-bar-wrapper">
        <form action="/admin/users" method="get" class="input-group input-group-sm search-form">
            <input type="text" name="search"
                   class="form-control search-input"
                   placeholder="Search customers..." value="<%= searchQuery || '' %>">
            <button class="btn search-btn">Search</button>
            <% if (searchQuery) { %>
                <a href="/admin/users" class="clear-search">Clear</a>
            <% } %>
        </form>
    </div>

    <!-- Card -->
    <div class="users-card">

        <table class="table custom-table">
            <thead>
                <tr>
                    <th><b>Name</b></th>
                    <th><b>Email</b></th>
                    <th><b>Phone No</b></th>
                    <th><b>Status</b></th>
                    <th><b>Action</b></th>
                </tr>
            </thead>

            <tbody>
  <% data.forEach(user => { %>
    <tr>

      <td data-label="Name"><%= user.name %></td>

      <td data-label="Email"><%= user.email %></td>

      <td data-label="Phone"><%= user.phone %></td>

      <td data-label="Status">
        <% if (user.isBlocked) { %>
          <span class="status blocked">Blocked</span>
        <% } else { %>
          <span class="status active">Active</span>
        <% } %>
      </td>

      <!-- ✅ ACTION COLUMN -->
      <td data-label="Action" class="action-cell">
        <button
          class="btn <%= user.isBlocked ? 'btn-unblock' : 'btn-block' %>"
          data-id="<%= user._id %>"
          data-name="<%= user.name %>"
          data-status="<%= user.isBlocked ? 'unblock' : 'block' %>">
          <%= user.isBlocked ? 'Unblock' : 'Block' %>
        </button>
      </td>

    </tr>
  <% }) %>
</tbody>

        </table>

    </div>

    <!-- Pagination -->
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>&search=<%= searchQuery || '' %>">
                        <%= i %>
                    </a>
                </li>
            <% } %>
        </ul>
    </nav>

</div>

<%- include("../../views/partials/admin/footer") %>


<!-- Confirmation Modal -->
<div id="confirmationModal" class="modal" style="display:none;">
    <div class="modal-content" style="max-width:400px; margin:100px auto; padding:20px; background:#fff; border-radius:8px; box-shadow:0 5px 15px rgba(0,0,0,0.3);">
        <p id="modal-message" style="font-size:16px; margin-bottom:20px;"></p>
        <div style="text-align:right;">
            <button id="modalCancel" style="margin-right:10px; padding:6px 12px;">Cancel</button>
            <button id="modalConfirm" style="background:#3b82f6; color:#fff; padding:6px 12px;">Confirm</button>
        </div>
    </div>
</div>

<script src="/js/admin/customers.js"></script>

