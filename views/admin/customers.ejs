<%- include("../../views/partials/admin/header") %>
<link rel="stylesheet" href="/css/admin/customers.css">
<div class="page-wrapper">

    <h2 class="page-title">User Management</h2>

    <!-- Search -->
    <div class="search-bar-wrapper">
    <form action="/admin/users" method="get" class="search-form">
        <input type="text" name="search"
               class="search-input"
               placeholder="Search customers..."
               value="<%= searchQuery || '' %>">

        <button type="submit" class="search-btn">Search</button>

        <% if (searchQuery) { %>
            <a href="/admin/users" class="clear-btn">Clear</a>
        <% } %>
    </form>
</div>

    <!-- Card -->
    <div class="users-card">

       <div class="table-responsive">
<table class="custom-table">
            <thead>
                <tr>
                    <th><b>Name</b></th>
                    <th><b>Email</b></th>
                    <th><b>Phone No</b></th>
                    <th><b>Status</b></th>
                    <th><b>Action</b></th>
                </tr>
            </thead>

            <tbody>
  <% data.forEach(user => { %>
    <tr>

      <td data-label="Name"><%= user.name %></td>

      <td data-label="Email"><%= user.email %></td>

      <td data-label="Phone"><%= user.phone %></td>

      <td data-label="Status">
        <% if (user.isBlocked) { %>
          <span class="status blocked">Blocked</span>
        <% } else { %>
          <span class="status active">Active</span>
        <% } %>
      </td>

      <!-- ACTION COLUMN -->
      <td data-label="Action" class="action-cell">
        <button
          class="btn <%= user.isBlocked ? 'btn-unblock' : 'btn-block' %>"
          data-id="<%= user._id %>"
          data-name="<%= user.name %>"
          data-status="<%= user.isBlocked ? 'unblock' : 'block' %>">
          <%= user.isBlocked ? 'Unblock' : 'Block' %>
        </button>
      </td>

    </tr>
  <% }) %>
</tbody>

        </table>
</div>
    </div>

    <!-- Pagination -->
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>&search=<%= searchQuery || '' %>">
                        <%= i %>
                    </a>
                </li>
            <% } %>
        </ul>
    </nav>

</div>

<%- include("../../views/partials/admin/footer") %>



<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/admin/customers.js"></script>


