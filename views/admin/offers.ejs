<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Offers Management</title>
  <link rel="stylesheet" href="/css/admin/offers.css">
</head>
<body>

<%- include("../../views/partials/admin/header") %> 

<div class="container">
  <div class="title-box">
    <div>
      <h2>Offers Management</h2>
      <p>Create and manage product and category offers.</p>
    </div>
    <div style="display: flex; gap: 15px;">
      <button class="btn-add" style="background:#368d07;" onclick="syncAllOffers()">Sync All Prices</button>
      <button class="btn-add" onclick="openAddModal()">+ Add Offer</button>
    </div>
  </div>

  
  <!-- Search -->
  <div class="search-bar">
    <form method="GET" action="/admin/offers">
      <input type="text" name="search" placeholder="Search offers..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
      <button class="btn-add" type="submit">Search</button>
    </form>

    <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
      <a href="/admin/offers"><button class="clear-btn">Clear</button></a>
    <% } %>
  </div>

  <!-- Offers Table -->
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Target</th>
        <th>Discount</th>
        <th>Validity</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if(offers.length === 0) { %>
        <tr><td colspan="7" style="text-align:center;padding:20px;">No offers found.</td></tr>
      <% } %>

      <% offers.forEach(offer => { %>
      <tr>
        <td><%= offer.name %></td>
        <td><%= offer.type %></td>
        <td>
          <% if (offer.target) { %>
            <%= offer.target.name || offer.target.productName %>
          <% } else { %>
            N/A
          <% } %>
        </td>
        <td>
          <% if (offer.discountType === "Fixed Amount") { %>
            ₹<%= offer.discountValue %> (Fixed)
          <% } else { %>
            <%= offer.discountValue %>%
          <% } %>
        </td>
        <td style="font-size: 13px;">
          <div style="color: #64748b;">Starts: <%= offer.startDate ? offer.startDate.toDateString() : 'N/A' %></div>
          <div>Ends: <%= offer.endDate ? offer.endDate.toDateString() : 'N/A' %></div>
        </td>
        <td>
          <% const today = new Date(); today.setHours(0,0,0,0); %>
          <% if(new Date(offer.endDate) < today) { %>
            <span class="status-draft" style="cursor:not-allowed; background:#fee2e2; color:#ef4444; border-color:#fca5a5;">Expired</span>
          <% } else if(offer.status === "Active") { %>
            <span class="status-active" onclick="toggleStatus('<%= offer._id %>')" style="cursor:pointer">Active</span>
          <% } else { %>
            <span class="status-draft" onclick="toggleStatus('<%= offer._id %>')" style="cursor:pointer">Inactive</span>
          <% } %>
        </td>
        <td>
          <button class="action-btn" style="background:#e0f2fe; color:#0369a1" onclick="openEditModal('<%= offer._id %>', '<%= offer.name %>', '<%= offer.type %>', '<%= offer.target ? offer.target._id : '' %>', '<%= offer.discountType %>', '<%= offer.discountValue %>', '<%= (offer.maxDiscountAmount != null) ? offer.maxDiscountAmount : '' %>', '<%= offer.startDate ? offer.startDate.toISOString().split('T')[0] : '' %>', '<%= offer.endDate ? offer.endDate.toISOString().split('T')[0] : '' %>')">Edit</button>
          <button class="action-btn btn-delete" onclick="deleteOffer('<%= offer._id %>')">Delete</button>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- ADD OFFER MODAL -->
<div class="modal-bg" id="addModal">
  <div class="modal-box">
    <h3>Add Offer</h3>
    
    <label>Offer Name</label>
    <input type="text" id="offerName" placeholder="e.g. Summer Sale 20%">

    <label>Offer Type</label>
    <select id="offerType" onchange="toggleTargetDropdown()">
      <option value="Product">Product Offer</option>
      <option value="Category">Category Offer</option>
      <option value="Referral">Referral Offer</option>
    </select>

    <label id="targetLabel">Select Target</label>
    <select id="offerTarget">
      <!-- Options populated  JS depending on type -->
    </select>

    <label>Discount Type</label>
    <select id="discountType" onchange="toggleDiscountType(false)">
      <option value="Percentage">Percentage (%)</option>
      <option value="Fixed Amount">Fixed Amount (₹)</option>
    </select>

    <label>Discount Value</label>
    <input type="number" id="discountValue" min="1" placeholder="Amount or %" style="margin-bottom: 10px;">

    <div id="maxDiscountContainer" style="margin-bottom: 15px;">
      <label>Maximum Discount (₹)</label>
      <input type="number" id="maxDiscountAmount" min="1" placeholder="e.g. 2000 (Optional)">
      <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">Leave empty for no limit</small>
    </div>

    <label>Start Date</label>
    <input type="date" id="startDate">

    <label>End Date</label>
    <input type="date" id="endDate">

    <div class="modal-btns">
      <button class="btn btn-blue" onclick="submitAdd()">Add</button>
      <button class="btn btn-gray" onclick="closeAddModal()">Cancel</button>
    </div>
  </div>
</div>

<!-- EDIT OFFER MODAL -->
<div class="modal-bg" id="editModal">
  <div class="modal-box">
    <h3>Edit Offer</h3>
    <input type="hidden" id="editOfferId">
    
    <label>Offer Name</label>
    <input type="text" id="editOfferName" placeholder="e.g. Summer Sale 20%">

    <label>Offer Type</label>
    <select id="editOfferType" onchange="toggleEditTargetDropdown()">
      <option value="Product">Product Offer</option>
      <option value="Category">Category Offer</option>
      <option value="Referral">Referral Offer</option>
    </select>

    <label id="editTargetLabel">Select Target</label>
    <select id="editOfferTarget">
      <!-- Options populated depending on type -->
    </select>

    <label>Discount Type</label>
    <select id="editDiscountType" onchange="toggleDiscountType(true)">
      <option value="Percentage">Percentage (%)</option>
      <option value="Fixed Amount">Fixed Amount (₹)</option>
    </select>

    <label>Discount Value</label>
    <input type="number" id="editDiscountValue" min="1" placeholder="Amount or %" style="margin-bottom: 10px;">

    <div id="editMaxDiscountContainer" style="margin-bottom: 15px;">
      <label>Maximum Discount (₹)</label>
      <input type="number" id="editMaxDiscountAmount" min="1" placeholder="e.g. 2000 (Optional)">
      <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">Leave empty for no limit</small>
    </div>

    <label>Start Date</label>
    <input type="date" id="editStartDate">

    <label>End Date</label>
    <input type="date" id="editEndDate">

    <div class="modal-btns">
      <button class="btn btn-blue" onclick="submitEdit()">Save Changes</button>
      <button class="btn btn-gray" onclick="closeEditModal()">Cancel</button>
    </div>
  </div>
</div>

<script>
  const products = <%- JSON.stringify(products || []) %>;
  const categories = <%- JSON.stringify(categories || []) %>;
</script>
<script src="/js/admin/offers.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>




</body>
</html>
