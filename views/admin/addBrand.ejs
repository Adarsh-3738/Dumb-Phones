<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Brand</title>
<link rel="stylesheet" href="/css/admin/addBrand.css">
  
</head>

<body>

  <!-- SIDEBAR -->

    <%- include("../../views/partials/admin/header") %> 


  <!-- MAIN CONTENT -->
  <div class="container">
    <div class="card">
      <h3>Add New Brand</h3>

      <form action="/admin/brands/add" method="POST" enctype="multipart/form-data">

        <div class="form-group">
          <label>Brand Name</label>
          <input type="text" name="name" required />
        </div>

        <div class="form-group">
          <label>Country</label>
          <input type="text" name="country" required />
        </div>

        <div class="form-group">
          <label>Founded Year</label>
          <input type="number" name="founded" required />
        </div>

        <div class="form-group">
          <label>Website URL</label>
          <input type="text" name="website" />
        </div>

        <div class="form-group">
          <label>Brand Logo</label>
          <input type="file" name="logo" accept="image/*">
        </div>

        <button type="submit" class="btn-submit">Create Brand</button>

      </form>
    </div>
  </div>

</body>
</html>
